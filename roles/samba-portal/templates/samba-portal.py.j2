#!/usr/bin/env python3
"""Samba self-service password portal.

Runs unprivileged behind Authelia forward-auth (nginx passes the authenticated
LLDAP username in the Remote-User header). The page lets a user see when their
Samba password was last changed and generate a fresh one — shown exactly once.
All privileged work is delegated to samba-helper.py via sudo; this process never
touches Samba or POSIX accounts directly and never stores the password.
"""
import html
import http.server
import json
import re
import secrets
import subprocess
import urllib.parse

HELPER = "{{ samba_portal_data_dir }}/samba-helper.py"
PORT = {{ samba_portal_port }}
PW_BYTES = {{ samba_portal_password_bytes }}
HOSTNAME = "{{ ansible_facts['hostname'] | default('server') }}"
{% raw %}
USERNAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")


def current_user(headers):
    """The authenticated username (LLDAP uid = POSIX name), lowercased."""
    raw = (headers.get("Remote-User") or "").strip().lower()
    return raw if USERNAME_RE.match(raw) else None


def helper(cmd, user, password=None):
    """Invoke the root helper via sudo; return its parsed JSON result."""
    stdin = (password + "\n") if password is not None else None
    p = subprocess.run(
        ["sudo", "-n", "/usr/bin/python3", HELPER, cmd, user],
        input=stdin, capture_output=True, text=True,
    )
    line = (p.stdout.strip().splitlines() or [""])[-1]
    try:
        return json.loads(line)
    except json.JSONDecodeError:
        return {"ok": False, "error": (p.stderr.strip() or "helper error")}


PAGE = """<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Samba password</title>
<style>
  :root {{ color-scheme: light dark; }}
  body {{ font-family: system-ui, sans-serif; max-width: 34rem; margin: 3rem auto;
         padding: 0 1.2rem; line-height: 1.5; }}
  h1 {{ font-size: 1.4rem; }}
  .card {{ border: 1px solid #8883; border-radius: 12px; padding: 1.2rem 1.4rem;
          margin: 1.2rem 0; }}
  .muted {{ color: #8888; }}
  .pw {{ font-family: ui-monospace, monospace; font-size: 1.35rem; letter-spacing: .04em;
        background: #8882; padding: .6rem .8rem; border-radius: 8px; word-break: break-all;
        user-select: all; }}
  button {{ font-size: 1rem; padding: .6rem 1.1rem; border-radius: 8px; border: 0;
           background: #3b82f6; color: #fff; cursor: pointer; }}
  button.warn {{ background: #b45309; }}
  .row {{ display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }}
  .note {{ background: #b453091a; border-left: 3px solid #b45309; padding: .7rem 1rem;
          border-radius: 6px; }}
  code {{ background: #8882; padding: .1rem .3rem; border-radius: 4px; }}
</style></head><body>
{body}
</body></html>"""


def status_page(user, msg=""):
    st = helper("status", user)
    if not st.get("ok"):
        rows = '<p class="note">Could not read your Samba status: {}</p>'.format(
            html.escape(st.get("error", "error")))
    elif st.get("exists"):
        groups = ", ".join(html.escape(g) for g in st.get("groups", [])) or "&mdash;"
        rows = (
            '<div class="row"><span class="muted">Account</span>'
            '<strong>{user}</strong></div>'
            '<div class="row"><span class="muted">Password last changed</span>'
            '<span>{last}</span></div>'
            '<div class="row"><span class="muted">Access groups</span>'
            '<span>{groups}</span></div>'
        ).format(user=html.escape(user),
                 last=html.escape(st.get("last_set") or "unknown"),
                 groups=groups)
    else:
        rows = (
            '<div class="row"><span class="muted">Account</span>'
            '<strong>{user}</strong></div>'
            '<p>You don\'t have a Samba account yet. Generating a password will '
            'create one with <strong>read-only</strong> access to the shared '
            'storage (plus your own private folder).</p>'
        ).format(user=html.escape(user))

    banner = '<p class="note">{}</p>'.format(html.escape(msg)) if msg else ""
    body = """
<h1>Samba password</h1>
<p class="muted">Signed in as <strong>{user}</strong>. Use this to set the
password for connecting to the network shares (<code>\\\\{host}</code>).</p>
{banner}
<div class="card">{rows}</div>
<form method="post" action="/reset">
  <button type="submit">Generate a new password</button>
</form>
<p class="muted" style="margin-top:1.5rem;font-size:.9rem">Your existing password
stops working the moment you generate a new one.</p>
""".format(user=html.escape(user), host=HOSTNAME, banner=banner, rows=rows)
    return PAGE.format(body=body)


def result_page(user, password, created):
    body = """
<h1>{icon} Your new Samba password</h1>
<div class="note"><strong>Copy it now.</strong> This is the only time it will be
shown &mdash; it is not stored anywhere and cannot be retrieved.</div>
<div class="card"><div class="pw">{pw}</div></div>
<p>Use it with username <strong>{user}</strong> when connecting to the shares.
{created_note}</p>
<form method="get" action="/"><button type="submit" class="warn">Done</button></form>
""".format(
        icon="&#127881;" if created else "&#128273;",
        pw=html.escape(password),
        user=html.escape(user),
        created_note=("Your account was just created with read-only access."
                      if created else ""),
    )
    return PAGE.format(body=body)


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass

    def _send(self, body_html, status=200):
        body = body_html.encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if urllib.parse.urlparse(self.path).path == "/health":
            body = b"ok"
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        user = current_user(self.headers)
        if not user:
            return self._send(PAGE.format(
                body="<h1>Not signed in</h1><p>No authenticated user.</p>"), 401)
        path = urllib.parse.urlparse(self.path).path
        if path == "/":
            self._send(status_page(user))
        else:
            self._send(PAGE.format(body="<h1>Not found</h1>"), 404)

    def do_POST(self):
        user = current_user(self.headers)
        if not user:
            return self._send(PAGE.format(
                body="<h1>Not signed in</h1><p>No authenticated user.</p>"), 401)
        if urllib.parse.urlparse(self.path).path != "/reset":
            return self._send(PAGE.format(body="<h1>Not found</h1>"), 404)
        # Drain any request body (the form has no fields, but be well-behaved).
        length = int(self.headers.get("Content-Length") or 0)
        if length:
            self.rfile.read(length)

        password = secrets.token_hex(PW_BYTES)
        res = helper("reset", user, password=password)
        if res.get("ok"):
            print("password reset for {} (created={})".format(
                user, res.get("created")), flush=True)
            self._send(result_page(user, password, res.get("created", False)))
        else:
            print("password reset FAILED for {}: {}".format(
                user, res.get("error")), flush=True)
            self._send(status_page(
                user, "Something went wrong: " + res.get("error", "error")), 500)


def main():
    server = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    print("samba-portal listening on 127.0.0.1:{}".format(PORT), flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
{% endraw %}
