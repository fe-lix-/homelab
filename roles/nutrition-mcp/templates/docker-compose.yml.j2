services:
  nutrition-mcp:
    image: {{ '${NUTRITION_MCP_IMAGE:-ghcr.io/fe-lix-/nutrition-mcp}:${NUTRITION_MCP_TAG:-latest}' }}
    container_name: nutrition-mcp
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ nutrition_mcp_port }}:8787"
    env_file: .env
    environment:
      DB_PATH: /data/nutrition.db
      OIDC_CLIENT_SECRET_FILE: /run/secrets/oidc_client_secret
      SYNC_TOKEN_FILE: /run/secrets/sync_token
    extra_hosts:
      - "auth.{{ base_domain }}:host-gateway"
    secrets:
      - oidc_client_secret
      - sync_token
    volumes:
      - ./data:/data
    user: "1000:1000"
    read_only: true
    tmpfs:
      - /tmp
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true
    mem_limit: 256m
    pids_limit: 128
    logging:
      driver: json-file
      options: {max-size: "10m", max-file: "3"}

  garmin-sync:
    image: {{ '${GARMIN_SYNC_IMAGE:-ghcr.io/fe-lix-/garmin-sync}:${GARMIN_SYNC_TAG:-latest}' }}
    container_name: garmin-sync
    restart: unless-stopped
    depends_on: [nutrition-mcp]
    environment:
      INGEST_URL: http://nutrition-mcp:8787/internal/ingest/garmin
      SYNC_TOKEN_FILE: /run/secrets/sync_token
      SYNC_INTERVAL_MIN: {{ '${GARMIN_SYNC_INTERVAL_MIN:-30}' }}
      BACKFILL_DAYS: {{ '${GARMIN_BACKFILL_DAYS:-365}' }}
    secrets:
      - sync_token
    volumes:
      - ./garmin:/data
    user: "1000:1000"
    read_only: true
    tmpfs:
      - /tmp
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true
    mem_limit: 256m
    pids_limit: 64
    logging:
      driver: json-file
      options: {max-size: "10m", max-file: "3"}

networks:
  default:
    driver: bridge
    ipam:
      config:
        - subnet: 10.200.0.0/29

secrets:
  oidc_client_secret:
    file: ./secrets/oidc_client_secret
  sync_token:
    file: ./secrets/sync_token
