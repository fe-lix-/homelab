# Managed by Ansible — do not edit by hand.
# MTA-STS policy endpoint for {{ mail_mta_sts_domains | join(', ') }}.
# `mta_sts_cert_present` controls whether the port-443 server blocks are
# rendered. On first-bootstrap deploys (no LE cert yet) only port 80 is
# served so certbot --webroot can complete HTTP-01 validation.

{% for d in mail_mta_sts_domains %}
server {
    listen 80;
    server_name mta-sts.{{ d }};

    # ACME HTTP-01 challenge support (used by certbot --webroot during issuance/renewal).
    location /.well-known/acme-challenge/ {
        root /var/www/mta-sts/{{ d }}/;
    }

{% if mta_sts_cert_present %}
    # Cert exists — redirect everything else to HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
    # No cert yet — leave port 80 working so receivers don't get TCP RSTs
    # during the brief bootstrap window before certbot issues.
    location = /.well-known/mta-sts.txt {
        root /var/www/mta-sts/{{ d }}/;
        default_type text/plain;
    }
    location / {
        return 404;
    }
{% endif %}
}

{% if mta_sts_cert_present %}
server {
    listen 443 ssl http2;
    server_name mta-sts.{{ d }};

    ssl_certificate /etc/letsencrypt/live/mta-sts.{{ mail_mta_sts_domains | first }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mta-sts.{{ mail_mta_sts_domains | first }}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # The only resource MTA-STS receivers fetch.
    location = /.well-known/mta-sts.txt {
        root /var/www/mta-sts/{{ d }}/;
        default_type text/plain;
        add_header Cache-Control "max-age={{ mail_mta_sts_max_age }}, public" always;
    }

    location / {
        return 404;
    }
}
{% endif %}

{% endfor %}
