[Unit]
Description=Dynamic DNS — update Gandi A records to current WAN IP
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 {{ ddns_data_dir }}/ddns.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ ddns_data_dir }}
