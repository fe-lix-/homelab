spring:
  security:
    oauth2:
      client:
        registration:
          authelia:
            provider: authelia
            client-id: komga
            client-secret: "{{ authelia_komga_oidc_secret }}"
            client-name: Authelia
            scope: openid,email,profile
            authorization-grant-type: authorization_code
            redirect-uri: "https://comics.{{ base_domain }}/login/oauth2/code/authelia"
        provider:
          authelia:
            issuer-uri: "https://auth.{{ base_domain }}"
            user-name-attribute: preferred_username

komga:
  # Filesystem watching doesn't reliably catch the KEPUBs the kcc-converter
  # writes to /data-kobo, so rescan hourly (+ on startup) to keep the Kobo
  # library current without manual "Scan library files" clicks.
  libraries-scan-cron: "0 0 * * * ?"
  libraries-scan-startup: true
