server {
    listen {{ nginx_port }} ssl;
    server_name audiobooks.{{ base_domain }};
    {{ ssl_params() }}
    {{ local_guard() }}

    # autoLaunch=0 is set by ABS after an Authelia access-denied — block it to
    # show a 403 instead of the native login form. Admins who need the native
    # form (e.g. to log in as `root`) bypass with an extra `native=1` param.
    location = /audiobookshelf/login/ {
        set $block_native "0";
        if ($arg_autoLaunch = "0") { set $block_native "1"; }
        if ($arg_native = "1")     { set $block_native "0"; }
        if ($block_native = "1")   { return 403; }
        proxy_pass http://127.0.0.1:{{ audiobookshelf_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ audiobookshelf_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # ABS uses Socket.IO — the websocket upgrade needs HTTP/1.1, without which
        # the client hangs on "checking" after login (upgrade returns 400).
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen {{ nginx_port }} ssl;
    server_name ebooks.{{ base_domain }};
    {{ ssl_params() }}
    {{ local_guard() }}
    {{ authelia_location() }}

    client_max_body_size 0;

    # OPDS feed — used by the Xteink X4 (Crosspoint). It authenticates with
    # Calibre-Web's own HTTP Basic auth, which forward-auth would break, so this
    # path is exempt from Authelia (still LAN/VPN-gated by local_guard).
    location ~ ^/opds(/.*)?$ {
        proxy_pass http://127.0.0.1:{{ calibre_web_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Web UI — gated by Authelia forward-auth.
    location / {
        {{ authelia_auth() }}
        proxy_pass http://127.0.0.1:{{ calibre_web_port }};
        proxy_set_header Host $host;
