    {{ block_dotfile_recon() }}
    {{ public_rate_limit() }}
    {{ authelia_location() }}
    {{ favicon_location() }}

    # Goploader downloads — open to everyone (links contain the decryption key)
    location /v/ {
        proxy_pass http://127.0.0.1:{{ goploader_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Minecraft IP whitelist portal — Authelia protected
    location = /minecraft {
        {{ authelia_auth() }}
        error_page 403 /mc-forbidden.html;
        proxy_pass http://127.0.0.1:{{ minecraft_whitelist_port }}/;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /landing.html {
        root /usr/share/nginx/html;
    }

    location = /mc-forbidden.html {
        internal;
        root /usr/share/nginx/html;
    }

    location / {
        rewrite ^ /landing.html last;
    }
}
