# Paul's games — public-facing static site at {{ paul_domain }}
# Uses its own Let's Encrypt cert (the wildcard only covers *.{{ base_domain }}).
# No local_guard: this is intentionally reachable from the internet.
# --- PUBLIC: Kobo Sync + Emma's Star Shop (single host) --------------------
# Internet-facing so the Kobo syncs and Emma spends tokens away from home. Two
# path-scoped locations, everything else -> 444 (no login page, UI, or API
# surface): /kobo/ -> Komga Kobo Sync (auth = long API key in the URL); /kids* ->
# manga-scheduler Star Shop (auth = secret ?key=). NO local_guard on purpose.
# Brute-force/DDoS defence: public_rate_limit (60 r/s backstop) + limit_conn +
# a strict 1 r/s zone on /kids + the nginx-public-auth fail2ban jail (bans IPs
# racking up 401/403s on either path).
server {
    listen {{ nginx_port }} ssl;
    server_name kobo.delval.eu;
    http2 on;
    ssl_certificate /etc/letsencrypt/live/kobo.delval.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kobo.delval.eu/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    {{ block_dotfile_recon() }}
    {{ public_rate_limit() }}
    limit_conn public_conn 20;

    # Komga's Kobo Sync sends a large X-Kobo-SyncToken response header that
    # overflows nginx's default proxy buffers (502 "upstream sent too big
    # header"). Enlarge the proxy buffers, as on the LAN comics vhost.
    proxy_buffer_size 64k;
    proxy_buffers 8 64k;
    proxy_busy_buffers_size 128k;

    location /kobo/ {
        proxy_pass http://127.0.0.1:{{ komga_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Emma's Star Shop (manga-scheduler) — auth = the secret ?key= magic link
    # (128-bit). Strict per-IP rate limit anyway, as defence-in-depth.
    # Covers /kids, /kids-confirm, /kids-deliver (prefix match).
    location /kids {
        limit_req zone=public_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:{{ manga_scheduler_ui_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Everything outside /kobo/ and /kids* is closed on this public host.
    location / {
        return 444;
    }
}

server {
