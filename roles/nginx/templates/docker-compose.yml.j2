---
services:
  nginx:
    image: nginx:{{ nginx_version }}
    container_name: nginx
    restart: unless-stopped
    network_mode: host
    volumes:
      - "{{ nginx_data_dir }}/conf.d:/etc/nginx/conf.d:ro"
      - "{{ nginx_data_dir }}/403.html:/usr/share/nginx/html/403.html:ro"
      - "{{ nginx_data_dir }}/landing.html:/usr/share/nginx/html/landing.html:ro"
      - "{{ nginx_data_dir }}/mc-forbidden.html:/usr/share/nginx/html/mc-forbidden.html:ro"
      - "{{ nginx_data_dir }}/favicon.svg:/usr/share/nginx/html/favicon.svg:ro"
      - "/etc/letsencrypt:/etc/letsencrypt:ro"
      - "/srv/games:/srv/games:ro"
    environment:
      TZ: "{{ timezone }}"
    # journald log driver makes container stdout queryable via `journalctl
    # CONTAINER_NAME=nginx`, which fail2ban watches for 444/recon patterns.
    # docker logs nginx + Loki ingestion via the Docker socket still work
    # (Docker abstracts the underlying driver for both).
    logging:
      driver: journald
