---
services:
  server:
    image: sdvd/server:{{ junimoserver_version }}
    container_name: junimoserver
    restart: unless-stopped
    stdin_open: true
    tty: true
    ports:
      - "127.0.0.1:{{ junimoserver_vnc_port }}:5800"
      - "127.0.0.1:{{ junimoserver_api_port }}:8080"
      # Game traffic. Stardew v1.6 primarily uses Steam relay (outbound NAT
      # traversal), so these ports do not currently need router forwarding.
      # If players can't connect, forward {{ junimoserver_game_port }}/udp
      # and {{ junimoserver_query_port }}/udp on the UniFi gateway.
      - "{{ junimoserver_game_port }}:24642/udp"
      - "{{ junimoserver_query_port }}:27015/udp"
    cap_add:
      # Required by GOG GalaxyAuth in the container to sync time
      - SYS_TIME
    volumes:
      - "{{ junimoserver_data_dir }}/game:/data/game"
      - "{{ junimoserver_data_dir }}/saves:/config/xdg/config/StardewValley"
      - "{{ junimoserver_data_dir }}/settings:/data/settings"
    environment:
      TZ: "{{ timezone }}"
      STEAM_AUTH_URL: "http://steam-auth:3001"
      VNC_PASSWORD: "{{ junimoserver_vnc_password }}"
      DISABLE_RENDERING: "{{ junimoserver_disable_rendering | string | lower }}"
      VERBOSE_LOGGING: "{{ junimoserver_verbose_logging | string | lower }}"
      SETTINGS_PATH: "/data/settings/server-settings.json"
      API_ENABLED: "true"
      API_PORT: "8080"
    depends_on:
      steam-auth:
        condition: service_healthy

  steam-auth:
    image: sdvd/steam-service:{{ junimoserver_version }}
    container_name: junimoserver-steam-auth
    restart: unless-stopped
    stdin_open: true
    tty: true
    expose:
      - "3001"
    volumes:
      - "{{ junimoserver_data_dir }}/steam-session:/data/steam-session"
      - "{{ junimoserver_data_dir }}/game:/data/game"
    environment:
      TZ: "{{ timezone }}"
      PORT: "3001"
      GAME_DIR: "/data/game"
      SESSION_DIR: "/data/steam-session"
      STEAM_USERNAME: "{{ junimoserver_steam_username }}"
      STEAM_PASSWORD: "{{ junimoserver_steam_password }}"
