#!/usr/bin/env python3
"""
Daily auto-updater for tracked manga series.

For each series in series-sources.json, fetches the source page to find the
latest volume count, compares it with local files, and triggers a download for
any series that has new volumes available.

Usage (manual test):
    sudo python3 /opt/manga-scheduler/manga-auto-update.py --dry-run
    sudo python3 /opt/manga-scheduler/manga-auto-update.py
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

SOURCES_FILE = Path("{{ manga_scheduler_data_dir }}/series-sources.json")
UPLOAD_DIR   = Path("{{ manga_scheduler_upload_dir }}")
COMICS_DIR   = Path("{{ manga_scheduler_comics_dir }}")
DATA_DIR     = Path("{{ manga_scheduler_data_dir }}")
PID_FILE          = DATA_DIR / "downloader.pid"
NEW_VOLUMES_FILE  = DATA_DIR / "new-volumes.json"
VENV_PYTHON  = DATA_DIR / "venv/bin/python"
DOWNLOADER   = DATA_DIR / "manga-downloader.py"
NTFY_URL     = "{{ manga_scheduler_ntfy_url }}"
NTFY_TOPIC   = "{{ manga_scheduler_ntfy_topic }}"
NTFY_TOKEN   = "{{ manga_scheduler_ntfy_token }}"
REQUEST_DELAY = 0.8  # seconds between tomo page fetches — be polite
{% raw %}

def log(msg: str):
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S")
    print(f"[{ts}] {msg}", flush=True)


def ntfy(title: str, body: str, priority: str = "default"):
    if not NTFY_URL or not NTFY_TOPIC:
        return
    try:
        req = urllib.request.Request(
            f"{NTFY_URL}/{NTFY_TOPIC}",
            data=body.encode(),
            headers={
                "Title": title,
                "Priority": priority,
                **({"Authorization": f"Bearer {NTFY_TOKEN}"} if NTFY_TOKEN else {}),
            },
            method="POST",
        )
        urllib.request.urlopen(req, timeout=10)
    except Exception as e:
        log(f"ntfy failed: {e}")


def fetch(url: str) -> str:
    req = urllib.request.Request(url, headers={
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"
    })
    with urllib.request.urlopen(req, timeout=20) as resp:
        return resp.read().decode("utf-8", errors="replace")


def get_remote_max_volume(url: str) -> int | None:
    """Fetch a tomo series page and parse the highest volume number from its title."""
    try:
        html = fetch(url)
    except Exception as e:
        log(f"  fetch error for {url}: {e}")
        return None

    # Restrict to H1 only — sidebar/related-series links can contain [01-N] patterns
    # that would otherwise match before the actual series title.
    h1 = re.search(r'<h1[^>]*>(.*?)</h1>', html, re.S | re.I)
    title = h1.group(1) if h1 else html

    # Title pattern: "Series Tomos [01-26]" or "Series Tomos [001-115]"
    m = re.search(r'\[0*1-(\d+)\]', title)
    if m:
        return int(m.group(1))

    # Single-volume: "[Completo]" with no range
    if re.search(r'\[completo\]', title, re.I):
        return 1

    return None


def count_local_volumes(folder: str) -> int:
    """Count CBZ/CBR files in the series folder across both comics and uploads dirs."""
    exts = {".cbz", ".cbr", ".pdf"}
    total = 0
    for base in (COMICS_DIR / folder, UPLOAD_DIR / folder):
        if base.is_dir():
            total += sum(
                1 for f in base.iterdir()
                if f.is_file() and f.suffix.lower() in exts
            )
    return total


def is_downloader_running() -> bool:
    if not PID_FILE.exists():
        return False
    try:
        pid = int(PID_FILE.read_text().strip())
        os.kill(pid, 0)
        return True
    except (ValueError, ProcessLookupError, PermissionError):
        PID_FILE.unlink(missing_ok=True)
        return False


def wait_for_downloader(timeout: int = 7200) -> bool:
    """Wait up to timeout seconds for any running download to finish."""
    start = time.time()
    while is_downloader_running():
        if time.time() - start > timeout:
            log("Timed out waiting for running download — giving up")
            return False
        log("  Download already in progress, waiting 60s...")
        time.sleep(60)
    return True


def run_download(url: str, series: str, dry_run: bool) -> bool:
    """Trigger manga-downloader.py for one series. Returns True on success."""
    if dry_run:
        log(f"  [dry-run] Would download: {series} from {url}")
        return True

    log(f"  Starting download: {series}")
    cmd = [
        "/usr/bin/xvfb-run", "-a",
        str(VENV_PYTHON), str(DOWNLOADER),
        "--url", url,
        "--user", "auto-update",
        "--series", series,
    ]
    env = os.environ.copy()
    env["PLAYWRIGHT_BROWSERS_PATH"] = str(DATA_DIR / "ms-playwright")
    try:
        result = subprocess.run(cmd, timeout=3600, capture_output=False, env=env)
        return result.returncode == 0
    except subprocess.TimeoutExpired:
        log(f"  Download timed out for {series}")
        return False
    except Exception as e:
        log(f"  Download error for {series}: {e}")
        return False


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true",
                        help="Check for updates but don't download anything")
    parser.add_argument("--series", metavar="FOLDER",
                        help="Only check/update this folder (by name)")
    args = parser.parse_args()

    if not SOURCES_FILE.exists():
        log("No series-sources.json found — nothing to do")
        sys.exit(0)

    sources = json.loads(SOURCES_FILE.read_text())
    if not sources:
        log("series-sources.json is empty — nothing to do")
        sys.exit(0)

    log(f"Checking {len(sources)} tracked series for updates...")

    updates_needed = []
    errors = []

    for folder, entry in sorted(sources.items(), key=lambda x: x[0].lower()):
        if args.series and folder.lower() != args.series.lower():
            continue

        url = entry.get("source_url", "")
        if not url:
            continue
        if "tomosmanga.com" not in url and "sushiscan.net" not in url:
            log(f"  {folder}: unsupported source ({url}) — skipping")
            continue

        local = count_local_volumes(folder)
        remote = get_remote_max_volume(url)
        time.sleep(REQUEST_DELAY)

        if remote is None:
            log(f"  {folder}: could not determine remote volume count — skipping")
            errors.append(folder)
            continue

        if remote > local:
            log(f"  {folder}: {local} local, {remote} on tomo → UPDATE NEEDED")
            updates_needed.append({"folder": folder, "url": url,
                                   "local": local, "remote": remote})
        else:
            log(f"  {folder}: up to date ({local}/{remote})")

    if not updates_needed:
        log("All tracked series are up to date.")
        NEW_VOLUMES_FILE.write_text(json.dumps({"series": []}))
        return

    log(f"\nFound {len(updates_needed)} series with new volumes:")
    for u in updates_needed:
        log(f"  {u['folder']}: {u['local']} → {u['remote']} (+{u['remote'] - u['local']} vols)")

    # Write banner file so the kids page can show what's arriving
    NEW_VOLUMES_FILE.write_text(json.dumps({"series": [u["folder"] for u in updates_needed]}))

    if args.dry_run:
        log("\n[dry-run] No downloads started.")
        return

    # Wait once for any running download to finish before starting the loop.
    # If it never finishes, abort the whole run — don't wait again per series.
    if is_downloader_running():
        log("A download is already running — waiting for it to finish (max 2h)...")
        if not wait_for_downloader():
            log("Timed out waiting for running download — aborting auto-update run.")
            ntfy("Manga auto-update skipped",
                 "A download was still running at the 2-hour timeout — will retry tomorrow.",
                 priority="low")
            return

    # Notify before starting (so the owner knows something is happening)
    names = ", ".join(u["folder"] for u in updates_needed)
    ntfy("Manga auto-update started",
         f"Downloading new volumes for: {names}",
         priority="low")

    succeeded = []
    failed = []

    for u in updates_needed:
        ok = run_download(u["url"], u["folder"], dry_run=False)
        (succeeded if ok else failed).append(u["folder"])

    # Summary notification
    parts = []
    if succeeded:
        parts.append(f"Downloaded: {', '.join(succeeded)}")
    if failed:
        parts.append(f"Failed: {', '.join(failed)}")
    if errors:
        parts.append(f"Skipped (fetch error): {', '.join(errors)}")

    summary = "\n".join(parts)
    log(f"\nDone. {summary}")

    if succeeded:
        ntfy("Manga auto-update complete",
             summary,
             priority="default")
    elif failed:
        ntfy("Manga auto-update: some failures",
             summary,
             priority="high")


if __name__ == "__main__":
    main()
