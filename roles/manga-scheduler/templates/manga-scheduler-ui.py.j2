COMIC_EXTENSIONS = {".cbz", ".cbr", ".pdf"}
IMAGE_EXTENSIONS = {".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp", ".tiff"}


def natural_sort_key(path: Path) -> list:
    """Sort key that treats numeric parts as integers for natural ordering."""
    return [
        int(part) if part.isdigit() else part.lower()
        for part in re.split(r"(\d+)", path.name)
    ]


def count_pages(filepath: Path) -> int:
    """Count image pages inside a comic archive."""
    suffix = filepath.suffix.lower()
    if suffix == ".cbz":
        try:
            with zipfile.ZipFile(filepath) as zf:
                return sum(
                    1 for name in zf.namelist()
                    if Path(name).suffix.lower() in IMAGE_EXTENSIONS
                )
        except zipfile.BadZipFile:
            pass
    elif suffix == ".cbr":
        try:
            result = subprocess.run(
                ["7z", "l", "-slt", str(filepath)],
                capture_output=True, text=True, timeout=30,
            )
            return sum(
                1 for line in result.stdout.splitlines()
                if line.startswith("Path = ")
                and Path(line.split(" = ", 1)[1]).suffix.lower() in IMAGE_EXTENSIONS
            )
        except (subprocess.TimeoutExpired, OSError):
            pass
    return 30


VOLUME_SUFFIX_RE = re.compile(
    r"\s*-\s*(Tomo|Vol\.?|Volume|Book)\s+\d+.*$", re.IGNORECASE
)
JOURNAL_LINE_RE = re.compile(r"^(\S+)\s+\S+\s+\S+\s+(.+)$")
RUN_START_RE = re.compile(r"^Series: '(.+)' \(\d+ files? remaining\)$")
MOVE_FILE_RE = re.compile(r"^Moving: .+ -> .+/(.+)$")


# --- Data functions ---

def series_name_from_file(stem: str) -> str:
    return VOLUME_SUFFIX_RE.sub("", stem).strip()


def discover_series() -> dict:
    """Return {series_name: [path, ...]} for files in UPLOAD_DIR."""
    series: dict = {}
    if not UPLOAD_DIR.is_dir():
        return series
    for entry in sorted(UPLOAD_DIR.iterdir()):
        if entry.is_dir():
            files = sorted(
                (f for f in entry.iterdir()
                if f.is_file() and f.suffix.lower() in COMIC_EXTENSIONS),
                key=natural_sort_key,
            )
            if files:
                series[entry.name] = files
        elif entry.is_file() and entry.suffix.lower() in COMIC_EXTENSIONS:
            name = series_name_from_file(entry.stem)
            series.setdefault(name, []).append(entry)
    for name in series:
        series[name] = sorted(series[name], key=natural_sort_key)
    return series


def load_state() -> dict:
    if STATE_FILE.exists():
        with STATE_FILE.open() as f:
            return json.load(f)
    return {"series_order": [], "current_index": 0}


def load_schedule() -> list[str]:
    """Load the active series list. Empty list means all series are active."""
    if SCHEDULE_FILE.exists():
        try:
            data = json.loads(SCHEDULE_FILE.read_text())
            return data.get("active_series", [])
        except (json.JSONDecodeError, OSError):
            pass
    return []


def save_schedule(active_series: list[str]):
    SCHEDULE_FILE.write_text(json.dumps({"active_series": active_series}, indent=2))


# --- Token economy ---
# Each member accrues TOKENS_PER_DAY per calendar day (unlimited accumulation);
# a delivery costs 1 token. Admins are exempt. Grants are lazy (applied whenever
# a member's balance is read), so no cron/timer is needed. All read-modify-write
# goes through _tokens_locked() so concurrent UI threads can't double-spend.

@contextlib.contextmanager
def _tokens_locked():
    """Open tokens.json under an exclusive flock, yield the dict, persist on exit."""
    TOKENS_FILE.parent.mkdir(parents=True, exist_ok=True)
    f = open(TOKENS_FILE, "a+")
    try:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.seek(0)
        raw = f.read()
        try:
            data = json.loads(raw) if raw.strip() else {}
        except json.JSONDecodeError:
            data = {}
        data.setdefault("users", {})
        yield data
        f.seek(0)
        f.truncate()
        json.dump(data, f, indent=2)
        f.flush()
    finally:
        fcntl.flock(f, fcntl.LOCK_UN)
        f.close()


def _rate_for(user: str, rec: dict = None) -> int:
    """This user's daily token accrual. Precedence: a runtime per-user rate set
    by an admin in the UI (stored on the user's token record as "rate"), then a
    deploy-time override, then the global default."""
    if rec is not None and rec.get("rate") is not None:
        return rec["rate"]
    return TOKENS_PER_DAY_OVERRIDES.get(user, TOKENS_PER_DAY)


_JST = datetime.timezone(datetime.timedelta(hours=9))


def _today_jst() -> str:
    return datetime.datetime.now(_JST).date().isoformat()


def _apply_accrual(user: str, rec: dict) -> None:
    """Grant this user's daily rate for each calendar day since last_grant (JST)."""
    rate = _rate_for(user, rec)
    today = _today_jst()
    last = rec.get("last_grant")
    if last is None:
        rec["balance"] = rec.get("balance", 0) + rate
        rec["last_grant"] = today
        return
    try:
        days = (datetime.date.fromisoformat(today) - datetime.date.fromisoformat(last)).days
    except ValueError:
        days = 0
    if days > 0:
        rec["balance"] = rec.get("balance", 0) + rate * days
        rec["last_grant"] = today


def get_balance(user: str) -> int:
    """Accrue then return the member's current token balance."""
    with _tokens_locked() as data:
        rec = data["users"].setdefault(user, {"balance": 0, "last_grant": None})
        _apply_accrual(user, rec)
        return rec["balance"]


def try_spend(user: str) -> tuple[bool, int]:
    """Accrue then spend 1 token, atomically. Returns (spent?, balance_after)."""
    with _tokens_locked() as data:
        rec = data["users"].setdefault(user, {"balance": 0, "last_grant": None})
        _apply_accrual(user, rec)
        if rec["balance"] >= 1:
            rec["balance"] -= 1
            return True, rec["balance"]
        return False, rec["balance"]


def refund(user: str, n: int = 1) -> None:
    """Return tokens to a member (used when a paid delivery fails to start)."""
    with _tokens_locked() as data:
        rec = data["users"].setdefault(user, {"balance": 0, "last_grant": _today_jst()})
        rec["balance"] = rec.get("balance", 0) + n


def _norm(user: str) -> str:
    """Canonical token-store key: the lowercased username. A person therefore has
    ONE balance whether they arrive via Authelia forward-auth (which capitalises
    the display name) or the lowercase /kids magic-link identity."""
    return (user or "").strip().lower()


def user_ctx(headers) -> dict:
    """Identify the requester from Authelia forward-auth headers + their balance.
    Keyed on Remote-User (the LLDAP uid) so it matches the kids page; lowercased."""
    user = _norm(headers.get("Remote-User") or headers.get("Remote-Name") or "unknown")
    groups = [g.strip() for g in (headers.get("Remote-Groups") or "").split(",") if g.strip()]
    is_admin = ADMIN_GROUP in groups
    return {"user": user, "is_admin": is_admin, "balance": get_balance(user)}


# --- Delivery queue ---
# Producers (this UI) append a request; the scheduler worker drains it one series
# per run, sharing queue.json + an flock with the worker. A burst of clicks can
# therefore never coalesce into a single delivery (the old pending.txt bug, where
# `systemctl start` on an already-running oneshot silently dropped the request).

@contextlib.contextmanager
def _queue_locked():
    """Open queue.json under an exclusive flock, yield the list, persist on exit."""
    QUEUE_FILE.parent.mkdir(parents=True, exist_ok=True)
    f = open(QUEUE_FILE, "a+")
    try:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.seek(0)
        raw = f.read()
        try:
            queue = json.loads(raw) if raw.strip() else []
        except json.JSONDecodeError:
            queue = []
        yield queue
        f.seek(0)
        f.truncate()
        json.dump(queue, f, indent=2)
        f.flush()
    finally:
        fcntl.flock(f, fcntl.LOCK_UN)
        f.close()


def enqueue(series: str, user: str, charged: bool) -> None:
    with _queue_locked() as queue:
        queue.append({"series": series, "user": user, "charged": charged})


def _dequeue_one(series: str, user: str, charged: bool) -> None:
    """Roll back the entry we just appended (used when the start command fails)."""
    with _queue_locked() as queue:
        for i in range(len(queue) - 1, -1, -1):
            e = queue[i]
            if (e.get("series") == series and e.get("user") == user
                    and bool(e.get("charged")) == charged):
                queue.pop(i)
                break


def deliver_series(user: str, series: str, is_admin: bool) -> tuple:
    """Spend a token (unless admin) and enqueue a delivery. Shared by the main UI
    and the kids page. The scheduler worker drains the queue one series per run,
    so rapid requests never collide. Returns (ok, message, balance_after_or_None)."""
    if series not in discover_series():
        return False, f"Series not found: {series}", None
    balance = None
    charged = False
    if not is_admin:
        spent, balance = try_spend(user)
        if not spent:
            return False, f"Not enough tokens — you have {balance}. You get {get_rate(user)}/day.", balance
        charged = True

    enqueue(series, user, charged)
    try:
        result = subprocess.run(
            ["systemctl", "start", "--no-block", "manga-scheduler.service"],
            capture_output=True, text=True, timeout=15,
        )
    except subprocess.SubprocessError as e:
        _dequeue_one(series, user, charged)
        if charged:
            refund(user)
            balance = (balance or 0) + 1
        return False, "Failed to start delivery: " + str(e), balance
    if result.returncode == 0:
        return True, "Delivery queued: " + series, balance
    _dequeue_one(series, user, charged)
    if charged:
        refund(user)
        balance = (balance or 0) + 1
    return False, "Failed: " + result.stderr.strip(), balance


# --- Kids mode (magic-link page for e-ink Kobo browsers) ---

def _kids_key() -> str:
    try:
        return KIDS_KEY_FILE.read_text().strip()
    except OSError:
        return ""


def valid_kids_key(key: str) -> bool:
    real = _kids_key()
    return bool(real) and hmac.compare_digest(key, real)


# --- Earn endpoint (public magic-link; Emma earns tokens, max 3 per 2 h) ---

EARN_KEY_FILE = DATA_DIR / "earn-key.txt"
EARN_MAX = 3
EARN_WINDOW_H = 2


def _earn_key() -> str:
    try:
        return EARN_KEY_FILE.read_text().strip()
    except OSError:
        return ""


def valid_earn_key(key: str) -> bool:
    real = _earn_key()
    return bool(real) and hmac.compare_digest(key, real)


def earn_tokens(user: str, n: int) -> tuple[bool, str, int]:
    """Grant n tokens (1–3) subject to the 2-hour window cap. Atomic."""
    n = max(1, min(n, 3))
    now = datetime.datetime.now(datetime.timezone.utc)
    cutoff = now - datetime.timedelta(hours=EARN_WINDOW_H)
    with _tokens_locked() as data:
        rec = data["users"].setdefault(user, {"balance": 0, "last_grant": None})
        _apply_accrual(user, rec)
        history = [
            e for e in rec.get("earn_history", [])
            if datetime.datetime.fromisoformat(e["ts"]) > cutoff
        ]
        already = sum(e["n"] for e in history)
        remaining = EARN_MAX - already
        if n > remaining:
            if remaining <= 0:
                return False, f"Maximum {EARN_MAX} étoiles par {EARN_WINDOW_H} h — reviens plus tard !", rec.get("balance", 0)
            return False, f"Tu peux encore gagner {remaining} étoile(s) — pas {n}.", rec.get("balance", 0)
        history.append({"ts": now.isoformat(), "n": n})
        rec["earn_history"] = history
        rec["balance"] = rec.get("balance", 0) + n
        return True, f"+{n} étoile(s) ! Tu en as maintenant {rec['balance']}.", rec["balance"]


def _earn_window_status(user: str) -> tuple[int, int]:
    """Return (already_earned_in_window, remaining_in_window)."""
    now = datetime.datetime.now(datetime.timezone.utc)
    cutoff = now - datetime.timedelta(hours=EARN_WINDOW_H)
    with _tokens_locked() as data:
        rec = data["users"].get(user, {})
        history = [
            e for e in rec.get("earn_history", [])
            if datetime.datetime.fromisoformat(e["ts"]) > cutoff
        ]
        already = sum(e["n"] for e in history)
    return already, max(0, EARN_MAX - already)


# --- Token grant endpoint (for Home Assistant / QR scan-to-earn) ---

def _grant_key() -> str:
    try:
        return GRANT_KEY_FILE.read_text().strip()
    except OSError:
        return ""


def valid_grant_key(key: str) -> bool:
    real = _grant_key()
    return bool(real) and hmac.compare_digest(key, real)


def grant_tokens(user: str, n: int) -> int:
    """Add n tokens to a user (also applies any pending daily accrual). Returns balance."""
    with _tokens_locked() as data:
        rec = data["users"].setdefault(user, {"balance": 0, "last_grant": _today_jst()})
        _apply_accrual(user, rec)
        rec["balance"] += n
        return rec["balance"]


# --- Admin token management (from the UI, admin group only) ---

USERNAME_RE = re.compile(r"^[A-Za-z0-9 ._-]{1,64}$")


def valid_username(user: str) -> bool:
    """A token-record key is just JSON, but keep it to sane identifier chars so an
    admin can't fat-finger junk (or markup) into the store."""
    return bool(user) and bool(USERNAME_RE.match(user))


def get_rate(user: str) -> int:
    """Effective daily accrual for a user, honouring any runtime override."""
    with _tokens_locked() as data:
        return _rate_for(user, data["users"].get(user))


def set_rate(user: str, rate: int) -> int:
    """Admin: set a user's runtime daily-accrual rate. Prospective — pending
    accrual is settled at the OLD rate first so the change never retroactively
    rewrites already-granted days. Returns the new rate."""
    with _tokens_locked() as data:
        rec = data["users"].setdefault(user, {"balance": 0, "last_grant": None})
        _apply_accrual(user, rec)
        rec["rate"] = rate
        return rate


def list_users() -> list[dict]:
    """All known members with settled balance + effective daily rate, for the
    admin panel. Sorted case-insensitively by name."""
    with _tokens_locked() as data:
        result = []
        for name, rec in data["users"].items():
            _apply_accrual(name, rec)
            result.append({"user": name, "balance": rec.get("balance", 0),
                           "rate": _rate_for(name, rec)})
    return sorted(result, key=lambda x: x["user"].lower())


# --- Series sources ---
# Maps folder-name → {source_url, display_name?} so we know where to check for
# new volumes. Edited through the admin Sources tab; keyed by the upload-queue
# folder name (same identifier used everywhere else in the delivery system).

def load_sources() -> dict:
    if SOURCES_FILE.exists():
        try:
            return json.loads(SOURCES_FILE.read_text())
        except (json.JSONDecodeError, OSError):
            pass
    return {}


def save_source(folder: str, url: str) -> None:
    sources = load_sources()
    if url.strip():
        sources[folder] = {"source_url": url.strip()}
    elif folder in sources:
        del sources[folder]
    SOURCES_FILE.write_text(json.dumps(sources, indent=2, ensure_ascii=False))


def delete_source(folder: str) -> None:
    sources = load_sources()
    if folder in sources:
        del sources[folder]
        SOURCES_FILE.write_text(json.dumps(sources, indent=2, ensure_ascii=False))


def _all_series_folders() -> list[str]:
    """Union of series folder names from /srv/comics and /srv/uploads/mangas, deduplicated."""
    seen: dict[str, str] = {}
    # Comics first so its casing wins on duplicates
    for d in [COMICS_DIR, UPLOAD_DIR]:
        if d.is_dir():
            for entry in sorted(d.iterdir()):
                if entry.is_dir() and not entry.name.startswith('.') and entry.name != 'script.sh':
                    key = entry.name.lower()
                    if key not in seen:
                        seen[key] = entry.name
    return sorted(seen.values(), key=str.lower)


def get_delivery_log(lines: int = 500) -> list[dict]:
    """Return parsed delivery runs from the systemd journal, newest first."""
    try:
        result = subprocess.run(
            ["journalctl", "-u", "manga-scheduler.service",
             "--no-pager", "-n", str(lines), "-o", "short-iso"],
            capture_output=True, text=True, timeout=5
        )
        raw = result.stdout.strip()
    except Exception:
        return []

    runs = []
    current: dict | None = None

    for line in raw.splitlines():
        m = JOURNAL_LINE_RE.match(line)
        if not m:
            continue
        timestamp_str, message = m.group(1), m.group(2)

        series_m = RUN_START_RE.match(message)
        if series_m:
            if current:
                runs.append(current)
            try:
                dt = datetime.datetime.fromisoformat(timestamp_str)
                formatted = dt.strftime("%Y-%m-%d %H:%M")
            except Exception:
                formatted = timestamp_str
            current = {"time": formatted, "series": series_m.group(1), "volumes": []}
            continue

        if current is None:
            continue

        move_m = MOVE_FILE_RE.match(message)
        if move_m:
            current["volumes"].append(move_m.group(1))

    if current:
        runs.append(current)

    runs.reverse()
    return runs


def get_timer_info() -> dict:
    try:
        result = subprocess.run(
            ["systemctl", "show", "manga-scheduler.timer",
             "--property=NextElapseUSecRealtime,LastTriggerUSec,ActiveState"],
            capture_output=True, text=True, timeout=5
        )
        props = {}
        for line in result.stdout.strip().splitlines():
            k, _, v = line.partition("=")
            props[k] = v
        return props
    except Exception:
        return {}


def read_download_status() -> dict:
    if DOWNLOAD_STATUS_FILE.exists():
        try:
            return json.loads(DOWNLOAD_STATUS_FILE.read_text())
        except (json.JSONDecodeError, OSError):
            pass
    return {"state": "idle"}


def read_download_history() -> list[dict]:
    if DOWNLOAD_HISTORY_FILE.exists():
        try:
            return json.loads(DOWNLOAD_HISTORY_FILE.read_text())
        except (json.JSONDecodeError, OSError):
            pass
    return []


def is_download_running() -> bool:
    if not DOWNLOAD_PID_FILE.exists():
        return False
    try:
        pid = int(DOWNLOAD_PID_FILE.read_text().strip())
        os.kill(pid, 0)
        return True
    except (ValueError, ProcessLookupError, PermissionError):
        return False


def get_next_series(series_map: dict, state: dict, active_series: list[str]) -> str | None:
    """Get the next series that would be delivered."""
    series_order = state.get("series_order", [])
    current_index = state.get("current_index", 0)
    if not series_order:
        return None
    order = [s for s in series_order if s in series_map]
    if active_series:
        filtered = [s for s in order if s in active_series]
        if filtered:
            order = filtered
    for offset in range(len(order)):
        idx = (current_index + offset) % len(order)
        name = order[idx % len(order)] if order else None
        if name and name in series_map:
            return name
    return None


def simulate_deliveries(series_map: dict, state: dict, active_series: list[str], count: int = 10) -> list[dict]:
    """Simulate the next N deliveries based on current state."""
    series_order = state.get("series_order", [])
    current_index = state.get("current_index", 0)
    if not series_order:
        return []

    order = [s for s in series_order if s in series_map]
    if active_series:
        filtered = [s for s in order if s in active_series]
        if filtered:
            order = filtered
    if not order:
        return []

    # Clone file data for simulation
    remaining = {}
    for s, files in series_map.items():
        remaining[s] = {
            "count": len(files),
            "total_pages": sum(count_pages(f) for f in files),
        }

    index = current_index % len(order) if order else 0
    preview = []

    for _ in range(count):
        picked = None
        for offset in range(len(order)):
            idx = (index + offset) % len(order)
            name = order[idx]
            if remaining.get(name, {}).get("count", 0) > 0:
                picked = name
                index = (idx + 1) % len(order)
                break
        if not picked:
            break

        r = remaining[picked]
        # Estimate batch: all files if total pages <= target, else accumulate until >= target
        if r["total_pages"] <= TARGET_PAGES:
            est_files = r["count"]
            est_pages = r["total_pages"]
        else:
            avg_pages = r["total_pages"] / r["count"] if r["count"] else 1
            est_files = max(1, min(r["count"], round(TARGET_PAGES / avg_pages)))
            est_pages = round(est_files * avg_pages)

        preview.append({
            "series": picked,
            "files": est_files,
            "pages": est_pages,
            "remaining_after": r["count"] - est_files,
        })

        r["count"] -= est_files
        r["total_pages"] -= est_pages

    return preview


