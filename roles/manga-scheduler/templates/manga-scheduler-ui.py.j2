/* Messages */
.success { background: #14532d; color: #86efac; padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1rem; }
.error { background: #7f1d1d; color: #fca5a5; padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1rem; }

/* Tables */
table { width: 100%; border-collapse: collapse; }
th { background: #16213e; padding: 0.5rem 0.75rem; text-align: left; color: #a78bfa; font-size: 0.85rem; }
td { padding: 0.5rem 0.75rem; border-bottom: 1px solid #2d2d4e; font-size: 0.85rem; }
tr.next td { background: #1e1e3f; }

/* Buttons */
button, .btn { background: #7c3aed; color: white; border: none; padding: 0.4rem 0.9rem; border-radius: 4px; cursor: pointer; font-size: 0.85rem; }
button:hover, .btn:hover { background: #6d28d9; }
button:disabled { opacity: 0.5; cursor: default; }
button.danger { background: #b91c1c; }
button.danger:hover { background: #991b1b; }
td.actions { display: flex; gap: 0.4rem; }
td.actions form { margin: 0; }
.retry-btn { background: #b45309; font-size: 0.78rem; padding: 0.25rem 0.6rem; }
.retry-btn:hover { background: #92400e; }

/* Sections */
.section { background: #16213e; border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem; }

/* Delivery log */
.log-scroll { max-height: 400px; overflow-y: auto; border: 1px solid #2d2d4e; border-radius: 6px; }
.log-scroll table { margin: 0; }
.log-scroll td { font-size: 0.82rem; vertical-align: top; }
.log-scroll td.volumes { color: #a0aec0; font-size: 0.78rem; }
.empty { color: #6b7280; font-size: 0.85rem; }

/* Download form */
.dl-form { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: end; }
.dl-form label { font-size: 0.82rem; color: #a0aec0; }
.dl-form input[type=text] { background: #1a1a2e; color: #e0e0e0; border: 1px solid #2d2d4e; border-radius: 4px; padding: 0.4rem 0.6rem; font-size: 0.85rem; }
.dl-form input[name=url] { flex: 1; min-width: 280px; }
.dl-form input[name=series] { width: 160px; }

/* Download progress */
.dl-progress { margin-top: 1rem; }
.status-line { font-size: 0.9rem; margin-bottom: 0.5rem; }
.status-line strong { color: #a78bfa; }
.dl-volumes { list-style: none; padding: 0; margin: 0.5rem 0; font-size: 0.82rem; }
.dl-volumes li { padding: 0.15rem 0; }
.dl-volumes .done { color: #86efac; }
.dl-volumes .downloading { color: #fbbf24; }
.dl-volumes .pending { color: #6b7280; }
.dl-volumes .failed { color: #fca5a5; }
.dl-errors li { color: #fca5a5; font-size: 0.82rem; }

/* Download history cards */
.dl-card { background: #16213e; border: 1px solid #2d2d4e; border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 0.5rem; }
.dl-card-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.25rem; }
.dl-card-date { color: #6b7280; font-size: 0.78rem; }
.dl-card-series { font-weight: 600; color: #e0e0e0; }
.dl-card-meta { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.35rem; font-size: 0.82rem; flex-wrap: wrap; }
.badge-ok { color: #86efac; }
.badge-fail { color: #fca5a5; }
.dl-card-errors { margin-top: 0.35rem; font-size: 0.78rem; color: #fca5a5; }
.dl-card-errors summary { cursor: pointer; color: #f87171; }
.dl-card-errors ul { margin: 0.25rem 0 0 1rem; padding: 0; }
.dl-card-errors li { padding: 0.1rem 0; word-break: break-word; }

/* Schedule */
.sched-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
@media (max-width: 700px) { .sched-grid { grid-template-columns: 1fr; } }
.sched-list { list-style: none; padding: 0; margin: 0; }
.sched-list li { padding: 0.3rem 0; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem; }
.sched-list input[type=checkbox] { accent-color: #7c3aed; }
.preview-table td { font-size: 0.82rem; }
.preview-num { color: #6b7280; font-size: 0.78rem; }

/* Sources */
.src-form { display: flex; gap: 0.4rem; align-items: center; }
.src-url-input { flex: 1; min-width: 220px; background: #1a1a2e; color: #e0e0e0; border: 1px solid #2d2d4e; border-radius: 4px; padding: 0.35rem 0.5rem; font-size: 0.82rem; }
tr.unmatched td { color: #6b7280; }
tr.unmatched td:first-child { color: #a0aec0; }
.badge-provider { font-size: 0.72rem; padding: 0.15rem 0.45rem; border-radius: 3px; font-weight: 600; white-space: nowrap; }
.badge-provider.tomo  { background: #1e3a5f; color: #60a5fa; }
.badge-provider.sushi { background: #3b2a1f; color: #fb923c; }
.badge-provider.other { background: #1f2d3b; color: #94a3b8; }
.badge-provider.none  { color: #374151; }
.src-stats { font-size: 0.82rem; color: #a0aec0; margin-bottom: 0.75rem; }
.src-stats strong { color: #a78bfa; }
"""


# --- Navigation ---

def _nav(active: str) -> str:
    tabs = [("Delivery", "/"), ("Download", "/download-page"), ("Schedule", "/schedule"), ("Sources", "/sources")]
    html = "<nav class='nav'>"
    for label, href in tabs:
        cls = " class='active'" if label == active else ""
        html += f"<a href='{href}'{cls}>{label}</a>"
    html += "</nav>"
    return html


def _page(title: str, active_tab: str, body: str, msg: str = "", error: bool = False, scripts: str = "") -> str:
    msg_html = ""
    if msg:
        cls = "error" if error else "success"
        msg_html = f"<div class='{cls}'>{escape(msg)}</div>"
    return (
        "<!DOCTYPE html>\n<html lang='en'>\n<head>\n"
        "  <meta charset='UTF-8'>\n"
        "  <meta name='viewport' content='width=device-width, initial-scale=1'>\n"
        f"  <title>{escape(title)} - Manga Scheduler</title>\n"
        f"  <style>{CSS}</style>\n"
        "</head>\n<body>\n"
        "  <h1>Manga Scheduler</h1>\n"
        + _nav(active_tab) + msg_html + body + scripts +
        "\n</body>\n</html>"
    )


# --- Delivery page ---

def render_delivery(msg: str = "", error: bool = False, ctx: dict = None) -> str:
    ctx = ctx or {"user": "Unknown", "is_admin": False, "balance": 0}
    series_map = discover_series()
    delivery_runs = get_delivery_log()

    if ctx["is_admin"]:
        token_html = f"<span>You: <strong>{escape(ctx['user'])}</strong> (admin \u2014 unlimited)</span>"
        can_deliver = True
    else:
        token_html = (
            f"<span>You: <strong>{escape(ctx['user'])}</strong></span>"
            f"<span>Tokens: <strong>{ctx['balance']}</strong> "
            f"<span style='color:#a0aec0'>(+{get_rate(ctx['user'])}/day)</span></span>"
        )
        can_deliver = ctx["balance"] >= 1

    info = (
        "<div class='info'>"
        + token_html
        + "<span style='color:#a0aec0'>Auto-delivery is off \u2014 spend 1 token to deliver a volume.</span>"
        "</div>"
    )

    # Series table
    rows = []
    for name, files in sorted(series_map.items()):
        total_mb = sum(f.stat().st_size for f in files) / (1024 * 1024)
        safe_name = escape(name)
        if ctx["is_admin"]:
            deliver_btn = (
                f"<form method='post' action='/deliver' onsubmit=\"return confirm('Deliver a volume of {safe_name}?')\">"
                f"<input type='hidden' name='series' value='{safe_name}'>"
                "<button type='submit'>Deliver</button></form>"
            )
        elif can_deliver:
            deliver_btn = (
                f"<form method='post' action='/deliver' onsubmit=\"return confirm('Spend 1 token to deliver a volume of {safe_name}? You have {ctx['balance']}.')\">"
                f"<input type='hidden' name='series' value='{safe_name}'>"
                "<button type='submit'>Deliver (1 token)</button></form>"
            )
        else:
            deliver_btn = "<button type='submit' disabled title='Not enough tokens'>Deliver (1 token)</button>"
        rows.append(
            "<tr>"
            f"<td>{safe_name}</td>"
            f"<td>{len(files)}</td>"
            f"<td>{'%.1f' % total_mb} MB</td>"
            "<td class='actions'>"
            + deliver_btn
            + f"<form method='post' action='/delete-series' onsubmit=\"return confirm('Delete \\'{safe_name}\\' ({len(files)} file(s)) from the upload queue? This cannot be undone.')\">"
            f"<input type='hidden' name='series' value='{safe_name}'>"
            "<button type='submit' class='danger'>Delete</button>"
            "</form>"
            "</td>"
            "</tr>"
        )
    rows_html = "\n".join(rows) if rows else "<tr><td colspan='4' class='empty'>No series in upload queue.</td></tr>"

    table = (
        "<table><thead><tr>"
        "<th>Series</th><th>Files</th><th>Size</th><th>Action</th>"
        "</tr></thead><tbody>\n" + rows_html + "\n</tbody></table>"
    )

    # Admin: per-member token management (grant tokens, set daily rate)
    admin_html = ""
    if ctx["is_admin"]:
        urows = []
        for u in list_users():
            su = escape(u["user"])
            urows.append(
                "<tr>"
                f"<td><strong>{su}</strong></td>"
                f"<td>{u['balance']}</td>"
                f"<td>{u['rate']}/day</td>"
                "<td class='actions'>"
                "<form method='post' action='/admin-grant'>"
                f"<input type='hidden' name='user' value='{su}'>"
                "<input type='number' name='n' value='1' min='-100' max='100' style='width:4rem'>"
                "<button type='submit'>Give</button></form>"
                "<form method='post' action='/admin-set-rate'>"
                f"<input type='hidden' name='user' value='{su}'>"
                f"<input type='number' name='rate' value='{u['rate']}' min='0' max='100' style='width:4rem'>"
                "<button type='submit'>Set /day</button></form>"
                "</td></tr>"
            )
        urows_html = "\n".join(urows) if urows else \
            "<tr><td colspan='4' class='empty'>No members yet.</td></tr>"
        admin_html = (
            "<div style='margin-top:1.5rem'><h2>Members (admin)</h2>"
            "<table><thead><tr>"
            "<th>User</th><th>Tokens</th><th>Per day</th><th>Actions</th>"
            "</tr></thead><tbody>\n" + urows_html + "\n</tbody></table>"
            "<form method='post' action='/admin-grant' "
            "style='margin-top:.6rem;display:flex;gap:.4rem;align-items:center;flex-wrap:wrap'>"
            "<span>Grant to a new user:</span>"
            "<input type='text' name='user' placeholder='username' required "
            "pattern='[A-Za-z0-9 ._-]{1,64}' style='width:11rem'>"
            "<input type='number' name='n' value='1' min='-100' max='100' style='width:4rem'>"
            "<button type='submit'>Give tokens</button></form>"
            "</div>"
        )

    # Delivery log
    if delivery_runs:
        log_rows = []
        for run in delivery_runs:
            vols = ", ".join(escape(v) for v in run["volumes"]) or "\u2014"
            log_rows.append(
                f"<tr><td>{escape(run['time'])}</td>"
                f"<td>{escape(run['series'])}</td>"
                f"<td class='volumes'>{vols}</td></tr>"
            )
        log_html = (
            "<div style='margin-top:1.5rem'><h2>Delivery Log</h2>"
            "<div class='log-scroll'><table>"
            "<thead><tr><th>Time</th><th>Series</th><th>Volumes</th></tr></thead>"
            "<tbody>" + "\n".join(log_rows) + "</tbody></table></div></div>"
        )
    else:
        log_html = "<div style='margin-top:1.5rem'><h2>Delivery Log</h2><p class='empty'>No deliveries recorded yet.</p></div>"

    return _page("Delivery", "Delivery", info + table + admin_html + log_html, msg, error)


# --- Download page ---

def render_download(msg: str = "", error: bool = False) -> str:
    running = is_download_running()

    # Form
    if running:
        form = (
            "<div class='section'><h2>New Download</h2>"
            "<form class='dl-form'>"
            "<div><label>URL</label><br>"
            "<input type='text' name='url' disabled placeholder='Download in progress...'></div>"
            "<div><label>Series name</label><br>"
            "<input type='text' name='series' disabled></div>"
            "<button type='submit' disabled>Downloading...</button>"
            "</form>"
            "<div id='dl-progress' class='dl-progress'></div>"
            "</div>"
        )
    else:
        form = (
            "<div class='section'><h2>New Download</h2>"
            "<form class='dl-form' method='post' action='/download'>"
            "<div><label>URL</label><br>"
            "<input type='text' name='url' placeholder='tomosmanga / sushiscan / manhwa-latino / mangolibreria URL' required></div>"
            "<div><label>Series name (optional)</label><br>"
            "<input type='text' name='series' placeholder='Auto-detect'></div>"
            "<button type='submit'>Start Download</button>"
            "</form>"
            "<div id='dl-progress' class='dl-progress'></div>"
            "</div>"
        )

    # Download history cards
    history = read_download_history()
    if history:
        cards = []
        for entry in reversed(history):
            started = entry.get("started", "")
            try:
                dt = datetime.datetime.fromisoformat(started)
                started = dt.strftime("%Y-%m-%d %H:%M")
            except Exception:
                pass
            state = entry.get("state", "unknown")
            is_ok = state == "completed"
            badge = f"<span class='badge-ok'>Completed</span>" if is_ok else f"<span class='badge-fail'>Failed</span>"
            count = f"{entry.get('completed', 0)}/{entry.get('total', 0)} volumes"

            retry_html = ""
            if not is_ok and entry.get("url") and not running:
                safe_url = escape(entry.get("url", ""))
                safe_series = escape(entry.get("series", ""))
                retry_html = (
                    f"<form method='post' action='/download' style='display:inline'>"
                    f"<input type='hidden' name='url' value='{safe_url}'>"
                    f"<input type='hidden' name='series' value='{safe_series}'>"
                    f"<button type='submit' class='retry-btn'>Retry</button>"
                    f"</form>"
                )

            errors = entry.get("errors", [])
            errors_html = ""
            if errors:
                err_items = "".join(f"<li>{escape(e)}</li>" for e in errors)
                errors_html = (
                    f"<div class='dl-card-errors'>"
                    f"<details><summary>{len(errors)} error(s)</summary>"
                    f"<ul>{err_items}</ul></details></div>"
                )

            cards.append(
                f"<div class='dl-card'>"
                f"<div class='dl-card-header'>"
                f"<span class='dl-card-series'>{escape(entry.get('series', ''))}</span>"
                f"<span class='dl-card-date'>{escape(started)}</span>"
                f"</div>"
                f"<div class='dl-card-meta'>{badge} <span>{escape(count)}</span> {retry_html}</div>"
                f"{errors_html}"
                f"</div>"
            )
        history_html = "<div style='margin-top:1.5rem'><h2>Download History</h2>" + "\n".join(cards) + "</div>"
    else:
        history_html = "<div style='margin-top:1.5rem'><h2>Download History</h2><p class='empty'>No downloads yet.</p></div>"

    # JS polling for progress
    scripts = """<script>
(function() {
  var prog = document.getElementById('dl-progress');
  var polling = null;
  function update() {
    fetch('/api/download-status').then(function(r) { return r.json(); }).then(function(d) {
      if (d.state === 'idle') { prog.innerHTML = ''; return; }
      var h = '<div class="status-line">Series: <strong>' + esc(d.series || '') + '</strong> &mdash; ';
      if (d.state === 'running') {
        h += '<span style="color:#fbbf24">' + esc(d.current || '') + '</span>';
        h += ' (' + (d.completed || 0) + '/' + (d.total || 0) + ' volumes)';
      } else if (d.state === 'completed') {
        h += '<span style="color:#86efac">Completed</span>';
        h += ' (' + (d.completed || 0) + '/' + (d.total || 0) + ' volumes)';
      } else {
        h += '<span style="color:#fca5a5">Failed</span>';
      }
      h += '</div>';
      var vols = d.volumes || [];
      if (vols.length > 0) {
        h += '<ul class="dl-volumes">';
        for (var i = 0; i < vols.length; i++) {
          var v = vols[i];
          var icon = v.state === 'done' ? '&#10003; ' : v.state === 'downloading' ? '&#8635; ' : v.state === 'failed' ? '&#10007; ' : '&#8226; ';
          h += '<li class="' + esc(v.state) + '">' + icon + esc(v.name) + '</li>';
        }
        h += '</ul>';
      }
      var errs = d.errors || [];
      if (errs.length > 0) {
        h += '<ul class="dl-errors">';
        for (var i = 0; i < errs.length; i++) h += '<li>' + esc(errs[i]) + '</li>';
        h += '</ul>';
      }
      prog.innerHTML = h;
      if (d.state !== 'running' && polling) { clearInterval(polling); polling = null; }
    }).catch(function() {});
  }
  function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
  update();
  polling = setInterval(update, 5000);
})();
</script>"""

    return _page("Download", "Download", form + history_html, msg, error, scripts)


# --- Schedule page ---

def render_schedule(msg: str = "", error: bool = False) -> str:
    series_map = discover_series()
    state = load_state()
    active_series = load_schedule()

    # Series checkboxes
    all_series = sorted(series_map.keys())
    items = []
    for name in all_series:
        safe = escape(name)
        checked = " checked" if (not active_series or name in active_series) else ""
        count = len(series_map[name])
        items.append(
            f"<li><label>"
            f"<input type='checkbox' name='active' value='{safe}'{checked}>"
            f" {safe} <span style='color:#6b7280'>({count} files)</span>"
            f"</label></li>"
        )
    if not items:
        items_html = "<p class='empty'>No series in upload queue.</p>"
    else:
        items_html = "<ul class='sched-list'>" + "\n".join(items) + "</ul>"

    selection = (
        "<div class='section'>"
        "<h2>Active Series</h2>"
        "<p style='font-size:0.82rem;color:#a0aec0;margin-top:0'>Selected series are delivered first. When all are done, remaining series begin.</p>"
        f"<form method='post' action='/schedule'>"
        f"{items_html}"
        "<div style='margin-top:0.75rem'>"
        "<button type='submit'>Save Selection</button>"
        "</div></form></div>"
    )

    # Preview next 10 deliveries
    preview = simulate_deliveries(series_map, state, active_series, 10)
    if preview:
        prows = []
        for i, p in enumerate(preview, 1):
            prows.append(
                f"<tr>"
                f"<td class='preview-num'>#{i}</td>"
                f"<td>{escape(p['series'])}</td>"
                f"<td>~{p['files']} files</td>"
                f"<td>~{p['pages']} pages</td>"
                f"<td style='color:#6b7280'>{p['remaining_after']} left</td>"
                f"</tr>"
            )
        preview_html = (
            "<div class='section'>"
            "<h2>Expected Next 10 Deliveries</h2>"
            "<p style='font-size:0.82rem;color:#a0aec0;margin-top:0'>Projection based on current queue. Actual deliveries may differ.</p>"
            "<table class='preview-table'><thead><tr>"
            "<th></th><th>Series</th><th>Files</th><th>Size</th><th>Remaining</th>"
            "</tr></thead><tbody>" + "\n".join(prows) + "</tbody></table>"
            "</div>"
        )
    else:
        preview_html = "<div class='section'><h2>Expected Next 10 Deliveries</h2><p class='empty'>No deliveries to preview.</p></div>"

    return _page("Schedule", "Schedule", selection + preview_html, msg, error)


# --- Sources page (admin) ---

def render_sources(ctx: dict, msg: str = "", error: bool = False) -> str:
    if not ctx["is_admin"]:
        return _page("Sources", "Sources",
                     "<div class='section'><p class='empty'>Admin access required.</p></div>",
                     "Not authorised", True)

    sources = load_sources()
    folders = _all_series_folders()
    matched = sum(1 for f in folders if f in sources)

    rows = []
    # Unmapped first, then alphabetical within each group
    unmapped = [f for f in folders if f not in sources]
    mapped   = [f for f in folders if f in sources]

    for folder in unmapped + mapped:
        entry = sources.get(folder, {})
        url = entry.get("source_url", "")
        safe = escape(folder)

        if "tomosmanga.com" in url:
            badge = "<span class='badge-provider tomo'>tomo</span>"
        elif "sushiscan.net" in url:
            badge = "<span class='badge-provider sushi'>sushi</span>"
        elif url:
            badge = "<span class='badge-provider other'>custom</span>"
        else:
            badge = "<span class='badge-provider none'>—</span>"

        row_cls = "" if url else " class='unmatched'"
        rows.append(
            f"<tr{row_cls}>"
            f"<td style='white-space:nowrap'>{safe}</td>"
            f"<td><form class='src-form' method='post' action='/admin-sources-save'>"
            f"<input type='hidden' name='folder' value='{safe}'>"
            f"<input type='text' name='url' value='{escape(url)}' class='src-url-input' "
            f"placeholder='https://tomosmanga.com/...'>"
            f"<button type='submit'>Save</button>"
            f"</form></td>"
            f"<td>{badge}</td>"
            f"<td><form method='post' action='/admin-sources-delete'>"
            f"<input type='hidden' name='folder' value='{safe}'>"
            f"<button type='submit' class='danger' {'disabled' if not url else ''}>Clear</button>"
            f"</form></td>"
            f"</tr>"
        )

    rows_html = "\n".join(rows) if rows else \
        "<tr><td colspan='4' class='empty'>No series folders found.</td></tr>"

    body = (
        "<div class='section'>"
        "<h2>Series Sources</h2>"
        "<p style='font-size:0.82rem;color:#a0aec0;margin-top:0'>"
        "Link each series folder to its download source. Unmapped series (shown first) "
        "cannot be checked for new volumes automatically.</p>"
        f"<p class='src-stats'><strong>{matched}</strong> of <strong>{len(folders)}</strong> series mapped</p>"
        "<table><thead><tr>"
        "<th>Folder</th><th>Source URL</th><th>Provider</th><th></th>"
        "</tr></thead><tbody>\n"
        + rows_html +
        "\n</tbody></table></div>"
    )
    return _page("Sources", "Sources", body, msg, error)


# --- Kids page rendering (standalone; big tap targets for e-ink, no JS) ---

# Light pastel cards read best on the Kobo's Kaleido color e-ink (the black text
# comes from the crisp B&W layer; the color is a light wash). (background, border).
KIDS_COLORS = [
    ("#ffd6e6", "#ec4899"),  # pink
    ("#d3ebff", "#3b82f6"),  # blue
    ("#d6f5d6", "#22c55e"),  # green
    ("#fff0b8", "#f59e0b"),  # yellow
    ("#e8d6ff", "#8b5cf6"),  # purple
    ("#ffdcc0", "#f97316"),  # orange
    ("#c9f2ee", "#14b8a6"),  # teal
    ("#ffcccc", "#ef4444"),  # red
]

KIDS_CSS = """
* { box-sizing: border-box; }
