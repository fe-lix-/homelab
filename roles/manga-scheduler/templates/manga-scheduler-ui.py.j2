def _earn_page(inner: str) -> str:
    return (
        "<!DOCTYPE html><html lang='fr'><head><meta charset='UTF-8'>"
        "<meta name='viewport' content='width=device-width, initial-scale=1'>"
        "<title>Étoiles d'Emma</title>"
        "<style>" + EARN_CSS + "</style></head><body>"
        "<div class='card'>"
        "<h1>⭐ Étoiles d'Emma</h1>"
        + inner +
        "</div></body></html>"
    )


def render_earn(key: str, msg: str = "", error: bool = False) -> str:
    user = _norm(KIDS_USER)
    balance = get_balance(user)
    already, remaining = _earn_window_status(user)

    stars_str = ("★" * balance) if balance <= 10 else f"★ \xd7{balance}"
    balance_html = (
        f"<div class='balance-box'>"
        f"Solde d'Emma : <b>{balance}</b> étoile(s)"
        f"<span class='stars'>{stars_str}</span>"
        f"</div>"
    )

    window_html = ""
    if already > 0:
        window_html = (
            f"<span class='window-badge'>"
            f"Doné ces {EARN_WINDOW_H} h : {already} / {EARN_MAX}"
            f"</span>"
        )

    msg_html = ""
    if msg:
        cls = "err" if error else "ok"
        msg_html = f"<div class='msg {cls}'>{escape(msg)}</div>"

    if remaining <= 0:
        buttons_html = (
            f"<div class='full-msg'>Maximum atteint pour ces {EARN_WINDOW_H} h.<br>"
            f"Revenez plus tard !</div>"
        )
    else:
        cells = []
        for n in [1, 2, 3]:
            label = f"+{n} " + ("⭐" * n)
            if n <= remaining:
                href = f"/earn-confirm?key={urllib.parse.quote(key)}&n={n}"
                cells.append(f"<a class='earn-btn' href='{escape(href)}'>{label}</a>")
            else:
                cells.append(f"<div class='earn-btn disabled'>{label}</div>")
        hint = "<p class='hint'>Choisissez combien d'étoiles donner à Emma :</p>"
        buttons_html = hint + "<div class='btn-grid'>" + "\n".join(cells) + "</div>"

    return _earn_page(balance_html + window_html + msg_html + buttons_html)


def render_earn_confirm(key: str, n: int) -> str:
    user = _norm(KIDS_USER)
    balance = get_balance(user)
    safe_key = escape(key)
    stars = "⭐" * n
    return _earn_page(
        f"<div class='confirm-title'>Donner <b>+{n} {stars}</b><br>à Emma ?</div>"
        f"<div class='confirm-sub'>Elle aura <b>{balance + n}</b> étoiles.</div>"
        "<form method='post' action='/earn-grant'>"
        f"<input type='hidden' name='key' value='{safe_key}'>"
        f"<input type='hidden' name='n' value='{n}'>"
        "<button class='yes-btn' type='submit'>Oui, donner !</button>"
        "</form>"
        f"<a class='no-btn' href='/earn?key={safe_key}'>Annuler</a>"
    )


# --- HTTP Handler ---

class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass

    def send_html(self, html: str, status: int = 200):
        body = html.encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def send_redirect(self, location: str):
        self.send_response(303)
        self.send_header("Location", location)
        self.end_headers()

    def send_json(self, data, status: int = 200):
        body = json.dumps(data, indent=2).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        params = urllib.parse.parse_qs(parsed.query)
        msg = params.get("msg", [""])[0]
        err = params.get("err", ["0"])[0] == "1"

        if parsed.path == "/":
            self.send_html(render_delivery(msg, err, user_ctx(self.headers)))
        elif parsed.path == "/download-page":
            self.send_html(render_download(msg, err))
        elif parsed.path == "/schedule":
            self.send_html(render_schedule(msg, err))
        elif parsed.path == "/kids":
            key = params.get("key", [""])[0]
            if not valid_kids_key(key):
                self.send_html("<h1>Enlace incorrecto</h1><p>Falta la clave o está mal escrita.</p>", 403)
                return
            self.send_html(render_kids(key, msg, err))
        elif parsed.path == "/kids-info":
            key = params.get("key", [""])[0]
            if not valid_kids_key(key):
                self.send_html("<h1>Enlace incorrecto</h1><p>Falta la clave o está mal escrita.</p>", 403)
                return
            series = params.get("series", [""])[0].strip()
            if not series or series not in discover_series():
                self.send_redirect("/kids?key=" + urllib.parse.quote(key))
                return
            self.send_html(render_kids_info(key, series))
        elif parsed.path == "/kids-confirm":
            key = params.get("key", [""])[0]
            if not valid_kids_key(key):
                self.send_html("<h1>Enlace incorrecto</h1><p>Falta la clave o está mal escrita.</p>", 403)
                return
            series = params.get("series", [""])[0].strip()
            if not series or series not in discover_series():
                self.send_redirect("/kids?key=" + urllib.parse.quote(key))
                return
            self.send_html(render_kids_confirm(key, series))
        elif parsed.path == "/earn":
            key = params.get("key", [""])[0]
            if not valid_earn_key(key):
                self.send_html("<h1>Lien incorrect</h1><p>Clé manquante ou incorrecte.</p>", 403)
                return
            self.send_html(render_earn(key, msg, err))
        elif parsed.path == "/earn-confirm":
            key = params.get("key", [""])[0]
            if not valid_earn_key(key):
                self.send_html("<h1>Lien incorrect</h1><p>Clé manquante ou incorrecte.</p>", 403)
                return
            try:
                n = max(1, min(int(params.get("n", ["1"])[0]), 3))
            except (ValueError, TypeError):
                n = 1
            self.send_html(render_earn_confirm(key, n))
        elif parsed.path == "/sources":
            self.send_html(render_sources(user_ctx(self.headers), msg, err))
        elif parsed.path == "/api/sources":
            self.send_json(load_sources())
        elif parsed.path == "/api/status":
            series_map = discover_series()
            state = load_state()
            timer = get_timer_info()
            self.send_json({
                "series": {k: len(v) for k, v in series_map.items()},
                "state": state,
                "timer": timer,
            })
        elif parsed.path == "/api/download-status":
            status = read_download_status()
            if status.get("state") == "running" and not is_download_running():
                status["state"] = "failed"
                status["current"] = "Process died unexpectedly"
            self.send_json(status)
        elif parsed.path == "/api/download-history":
            self.send_json(read_download_history())
        else:
            self.send_html("<h1>404</h1>", 404)

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(length).decode()
        params = urllib.parse.parse_qs(body)

        if self.path == "/download":
            self._handle_download(params)
        elif self.path == "/deliver":
            self._handle_deliver(params)
        elif self.path == "/kids-deliver":
            self._handle_kids_deliver(params)
        elif self.path == "/earn-grant":
            self._handle_earn_grant(params)
        elif self.path == "/grant":
            self._handle_grant(params)
        elif self.path == "/admin-grant":
            self._handle_admin_grant(params)
        elif self.path == "/admin-set-rate":
            self._handle_admin_set_rate(params)
        elif self.path == "/delete-series":
            self._handle_delete_series(params)
        elif self.path == "/schedule":
            self._handle_schedule(params)
        elif self.path == "/admin-sources-save":
            self._handle_sources_save(params)
        elif self.path == "/admin-sources-delete":
            self._handle_sources_delete(params)
        else:
            self.send_html("<h1>404</h1>", 404)

    def _handle_earn_grant(self, params: dict):
        key = params.get("key", [""])[0]
        if not valid_earn_key(key):
            self.send_html("<h1>Lien incorrect</h1><p>Clé manquante ou incorrecte.</p>", 403)
            return
        try:
            n = max(1, min(int(params.get("n", ["1"])[0]), 3))
        except (ValueError, TypeError):
            n = 1
        user = _norm(KIDS_USER)
        ok, message, _balance = earn_tokens(user, n)
        q = "/earn?key=" + urllib.parse.quote(key) + "&msg=" + urllib.parse.quote(message)
        if not ok:
            q += "&err=1"
        self.send_redirect(q)

    def _handle_deliver(self, params: dict):
        series = params.get("series", [""])[0].strip()
        ctx = user_ctx(self.headers)
        if not series:
            self.send_redirect("/?msg=No+series+specified&err=1")
            return
        ok, message, balance = deliver_series(ctx["user"], series, ctx["is_admin"])
        if ok:
            suffix = "" if ctx["is_admin"] else f" — {balance} token(s) left"
            self.send_redirect("/?msg=" + urllib.parse.quote(
                message + " — will appear in Komga shortly" + suffix))
        else:
            self.send_redirect("/?msg=" + urllib.parse.quote(message) + "&err=1")

    def _handle_kids_deliver(self, params: dict):
        key = params.get("key", [""])[0]
        if not valid_kids_key(key):
            self.send_html("<h1>Enlace incorrecto</h1><p>Falta la clave o está mal escrita.</p>", 403)
            return
        series = params.get("series", [""])[0].strip()
        if not series:
            self.send_redirect("/kids?key=" + urllib.parse.quote(key))
            return
        ok, message, _balance = deliver_series(KIDS_USER, series, is_admin=False)
        friendly = "¡Bien! Sincroniza tu Kobo para leerlo." if ok else "Ups, no se pudo enviar."
        q = "/kids?key=" + urllib.parse.quote(key) + "&msg=" + urllib.parse.quote(friendly)
        if not ok:
            q += "&err=1"
        self.send_redirect(q)

    def _handle_grant(self, params: dict):
        """Add tokens to a user. Authenticated by the grant key (for Home Assistant /
        QR scan-to-earn). Returns JSON so HA can read the new balance."""
        if not valid_grant_key(params.get("key", [""])[0]):
            self.send_json({"error": "forbidden"}, 403)
            return
        user = _norm(params.get("user", [""])[0]) or KIDS_USER
        try:
            n = int(params.get("n", ["1"])[0])
        except (ValueError, TypeError):
            n = 1
        n = max(1, min(n, 10))
        balance = grant_tokens(user, n)
        self.send_json({"ok": True, "user": user, "granted": n, "balance": balance})

    def _handle_admin_grant(self, params: dict):
        """Admin (Authelia admin group): give/deduct tokens for a member."""
        ctx = user_ctx(self.headers)
        if not ctx["is_admin"]:
            self.send_redirect("/?msg=" + urllib.parse.quote("Not authorised") + "&err=1")
            return
        user = _norm(params.get("user", [""])[0])
        if not valid_username(user):
            self.send_redirect("/?msg=" + urllib.parse.quote("Invalid username") + "&err=1")
            return
        try:
            n = int(params.get("n", ["1"])[0])
        except (ValueError, TypeError):
            n = 1
        n = max(-100, min(n, 100))
        balance = grant_tokens(user, n)
        verb, prep = ("Gave", "to") if n >= 0 else ("Removed", "from")
        # (username already normalised to lowercase above)
        self.send_redirect("/?msg=" + urllib.parse.quote(
            f"{verb} {abs(n)} token(s) {prep} {user} — balance now {balance}."))

    def _handle_admin_set_rate(self, params: dict):
        """Admin (Authelia admin group): set a member's daily token rate."""
        ctx = user_ctx(self.headers)
        if not ctx["is_admin"]:
            self.send_redirect("/?msg=" + urllib.parse.quote("Not authorised") + "&err=1")
            return
        user = _norm(params.get("user", [""])[0])
        if not valid_username(user):
            self.send_redirect("/?msg=" + urllib.parse.quote("Invalid username") + "&err=1")
            return
        try:
            rate = int(params.get("rate", ["1"])[0])
        except (ValueError, TypeError):
            rate = 1
        rate = max(0, min(rate, 100))
        set_rate(user, rate)
        self.send_redirect("/?msg=" + urllib.parse.quote(
            f"Set {user}'s daily tokens to {rate}/day."))

    def _handle_delete_series(self, params: dict):
        series = params.get("series", [""])[0].strip()
        if not series:
            self.send_redirect("/?msg=No+series+specified&err=1")
            return

        # Resolve via discover_series so we only ever delete real paths under
        # UPLOAD_DIR (guards against path traversal / arbitrary names).
        series_map = discover_series()
        if series not in series_map:
            self.send_redirect("/?msg=" + urllib.parse.quote("Series not found: " + series) + "&err=1")
            return

        try:
            target_dir = UPLOAD_DIR / series
            if target_dir.is_dir() and target_dir.resolve().parent == UPLOAD_DIR.resolve():
                shutil.rmtree(target_dir)
            else:
                for f in series_map[series]:
                    if f.is_file() and f.resolve().parent == UPLOAD_DIR.resolve():
                        f.unlink()
        except OSError as e:
            self.send_redirect("/?msg=" + urllib.parse.quote("Delete failed: " + str(e)) + "&err=1")
            return

        # Drop it from the schedule's active list if present (harmless if absent).
        active = load_schedule()
        if series in active:
            save_schedule([s for s in active if s != series])

        self.send_redirect("/?msg=" + urllib.parse.quote("Deleted from upload queue: " + series))

    def _handle_download(self, params: dict):
        url = params.get("url", [""])[0].strip()
        series = params.get("series", [""])[0].strip()

        allowed = ("https://tomosmanga.com/", "https://sushiscan.net/", "https://manhwa-latino.com/", "https://mangolibreria.com/")
        if not url or not any(url.startswith(d) for d in allowed):
            self.send_redirect("/download-page?msg=" + urllib.parse.quote("Invalid URL: must be from tomosmanga.com, sushiscan.net, manhwa-latino.com, or mangolibreria.com") + "&err=1")
            return

        if is_download_running():
            self.send_redirect("/download-page?msg=" + urllib.parse.quote("A download is already in progress.") + "&err=1")
            return

        user = self.headers.get("Remote-Name") or self.headers.get("Remote-User") or "Unknown"
        # Wrap in xvfb-run: the Fireload step must run a HEADED browser (its
        # invisible reCAPTCHA rejects headless), which needs a virtual display.
        cmd = ["/usr/bin/xvfb-run", "-a",
               str(DATA_DIR / "venv" / "bin" / "python"), str(DOWNLOADER_SCRIPT),
               "--url", url, "--user", user]
        if series:
            cmd.extend(["--series", series])

        subprocess.Popen(
            cmd,
            stdout=open(DATA_DIR / "downloader.log", "a"),
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )

        msg = urllib.parse.quote("Download started" + (": " + series if series else ""))
        self.send_redirect("/download-page?msg=" + msg)

    def _handle_schedule(self, params: dict):
        active = params.get("active", [])
        save_schedule(active)
        self.send_redirect("/schedule?msg=" + urllib.parse.quote(f"Schedule updated: {len(active)} series selected"))

    def _handle_sources_save(self, params: dict):
        ctx = user_ctx(self.headers)
        if not ctx["is_admin"]:
            self.send_redirect("/sources?msg=" + urllib.parse.quote("Not authorised") + "&err=1")
            return
        folder = params.get("folder", [""])[0].strip()
        url = params.get("url", [""])[0].strip()
        if not folder:
            self.send_redirect("/sources?msg=Missing+folder&err=1")
            return
        save_source(folder, url)
        verb = "Saved" if url else "Cleared"
        self.send_redirect("/sources?msg=" + urllib.parse.quote(f"{verb}: {folder}"))

    def _handle_sources_delete(self, params: dict):
        ctx = user_ctx(self.headers)
        if not ctx["is_admin"]:
            self.send_redirect("/sources?msg=" + urllib.parse.quote("Not authorised") + "&err=1")
            return
        folder = params.get("folder", [""])[0].strip()
        if not folder:
            self.send_redirect("/sources?msg=Missing+folder&err=1")
            return
        delete_source(folder)
        self.send_redirect("/sources?msg=" + urllib.parse.quote(f"Cleared: {folder}"))


if __name__ == "__main__":
    # ThreadingHTTPServer (not HTTPServer): the single-threaded server froze the
    # whole UI whenever one request blocked — e.g. sendall() to a client that
    # stalled without closing the connection. Each request now runs in its own
    # daemon thread, and Handler.timeout bounds stalled reads/writes so a dead
    # connection can't leak a thread forever.
    Handler.timeout = 60
    server = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    server.daemon_threads = True
    print("Manga Scheduler UI listening on 127.0.0.1:" + str(PORT))
    server.serve_forever()
