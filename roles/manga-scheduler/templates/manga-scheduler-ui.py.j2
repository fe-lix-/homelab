def _kids_page(inner: str) -> str:
    return (
        "<!DOCTYPE html><html lang='es'><head><meta charset='UTF-8'>"
        "<meta name='viewport' content='width=device-width, initial-scale=1'>"
        "<title>Los cómics de Emma</title><style>" + KIDS_CSS + "</style></head><body>"
        "<h1>Los cómics de Emma</h1>"
        + inner +
        "</body></html>"
    )


def render_kids(key: str, msg: str = "", error: bool = False) -> str:
    balance = get_balance(KIDS_USER)
    series_map = discover_series()
    can = balance >= 1

    if can:
        stars = ("★" * balance) if balance <= 12 else ("★ ×%d" % balance)
        tokens_line = f"<div class='k-tokens'>Tienes <b>{balance}</b> <span class='stars'>{stars}</span></div>"
    else:
        tokens_line = "<div class='k-tokens'>No te quedan estrellas — ¡vuelve mañana!</div>"

    msg_html = f"<div class='k-msg{' err' if error else ''}'>{escape(msg)}</div>" if msg else ""

    rows = []
    for i, (name, files) in enumerate(sorted(series_map.items())):
        safe = escape(name)
        bg, bd = KIDS_COLORS[i % len(KIDS_COLORS)]
        style = f"background:{bg};border-color:{bd}"
        label = f"<span class='k-name'>{safe}</span><span class='k-left'>quedan {len(files)}</span>"
        if can:
            # Tap goes to the info page first, then confirm.
            href = "/kids-info?key=" + urllib.parse.quote(key) + "&series=" + urllib.parse.quote(name)
            inner = f"<a class='k-item' href='{escape(href)}' style='{style}'>{label}</a>"
        else:
            inner = f"<div class='k-item k-off' style='{style}'>{label}</div>"
        rows.append(f"<div class='k-cell'>{inner}</div>")
    items = "\n".join(rows) if rows else "<p class='k-empty'>No hay cómics en espera ahora mismo.</p>"

    # New-volumes banner: written by manga-auto-update when it finds new volumes
    new_banner = ""
    try:
        if NEW_VOLUMES_FILE.exists():
            nv = json.loads(NEW_VOLUMES_FILE.read_text())
            names = nv.get("series", [])
            if names:
                if len(names) == 1:
                    joined = names[0]
                elif len(names) == 2:
                    joined = f"{names[0]} y {names[1]}"
                else:
                    joined = ", ".join(names[:-1]) + f" y {names[-1]}"
                new_banner = f"<div class='k-new-banner'>📦 ¡Hay tomos nuevos de <b>{escape(joined)}</b>!</div>"
    except Exception:
        pass

    return _kids_page(
        tokens_line + msg_html + new_banner
        + "<p class='k-hint'>Toca un cómic para enviarlo a tu Kobo.</p>"
        + "<div class='k-grid'>" + items + "</div>"
    )


def render_kids_confirm(key: str, series: str) -> str:
    balance = get_balance(KIDS_USER)
    safe_key = escape(key)
    safe = escape(series)
    return _kids_page(
        f"<div class='k-confirm'>¿Enviar <b>{safe}</b> a tu Kobo?</div>"
        f"<div class='k-cost'>Cuesta 1 estrella. Te quedan <b>{balance}</b>.</div>"
        "<div class='k-choices'>"
        "<form method='post' action='/kids-deliver'>"
        f"<input type='hidden' name='key' value='{safe_key}'>"
        f"<input type='hidden' name='series' value='{safe}'>"
        "<button class='k-yes' type='submit'>Sí, enviar</button>"
        "</form>"
        f"<a class='k-no' href='/kids?key={safe_key}'>No, volver</a>"
        "</div>"
    )


def render_kids_info(key: str, series: str) -> str:
    """Story teaser page shown before the confirm step."""
    safe_key = escape(key)
    safe = escape(series)
    confirm_href = escape("/kids-confirm?key=" + urllib.parse.quote(key) + "&series=" + urllib.parse.quote(series))
    back_href = escape("/kids?key=" + urllib.parse.quote(key))
    balance = get_balance(KIDS_USER)
    can = balance >= 1

    info = {}
    try:
        if SERIES_INFO_FILE.exists():
            all_info = json.loads(SERIES_INFO_FILE.read_text())
            info = all_info.get(series, {})
    except Exception:
        pass

    synopsis = info.get("synopsis", "")
    image_url = info.get("image_url", "")

    img_html = (f"<img class='k-cover' src='{escape(image_url)}' alt='{safe}' loading='lazy'>"
                if image_url else "")

    synopsis_html = f"<p class='k-synopsis'>{escape(synopsis)}</p>" if synopsis else ""

    info_block = (
        f"<div class='k-info-wrap'>{img_html}{synopsis_html}</div>"
        if (img_html or synopsis_html) else ""
    )

    if can:
        action_btn = (
            f"<a class='k-yes' href='{confirm_href}'>Pedir este cómic (1 ⭐)</a>"
        )
    else:
        action_btn = "<div class='k-cost'>No te quedan estrellas — ¡vuelve mañana!</div>"

    return _kids_page(
        f"<a class='k-back' href='{back_href}'>← Volver</a>"
        f"<div class='k-title-info'>{safe}</div>"
        + info_block
        + action_btn
    )


