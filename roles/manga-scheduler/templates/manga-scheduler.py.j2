#!/usr/bin/env python3
"""Manga Scheduler — drip-feed manga series from uploads into Komga library."""

import argparse
import datetime
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
import zipfile
from base64 import b64encode
from pathlib import Path

UPLOAD_DIR = Path("{{ manga_scheduler_upload_dir }}")
COMICS_DIR = Path("{{ manga_scheduler_comics_dir }}")
DATA_DIR = Path("{{ manga_scheduler_data_dir }}")
TARGET_PAGES = {{ manga_scheduler_target_pages }}
QUEUE_FILE = DATA_DIR / "queue.json"
WORKER_LOCK = DATA_DIR / "worker.lock"
TOKENS_FILE = DATA_DIR / "tokens.json"
KOMGA_URL = "http://127.0.0.1:{{ komga_port }}"
KOMGA_USER = "{{ komga_admin_email }}"
KOMGA_PASSWORD = "{{ komga_admin_password }}"
NTFY_URL = "{{ manga_scheduler_ntfy_url }}"
NTFY_TOPIC = "{{ manga_scheduler_ntfy_topic }}"
NTFY_TOKEN = "{{ manga_scheduler_ntfy_token }}"

VOLUME_SUFFIX_RE = re.compile(
    r"\s*-\s*(Tomo|Vol\.?|Volume|Book)\s+\d+.*$", re.IGNORECASE
)
COMIC_EXTENSIONS = {".cbz", ".cbr", ".pdf"}


def natural_sort_key(path: Path) -> list:
    """Sort key that treats numeric parts as integers for natural ordering."""
    return [
        int(part) if part.isdigit() else part.lower()
        for part in re.split(r"(\d+)", path.name)
    ]


def series_name_from_file(stem: str) -> str:
    """Extract series name from a file stem by stripping volume suffix."""
    return VOLUME_SUFFIX_RE.sub("", stem).strip()


def discover_series(upload_dir: Path) -> dict[str, list[Path]]:
    """
    Return a mapping of series_name -> sorted list of file paths.
    Directory-based: each subdir is a series.
    File-based: top-level comic files grouped by regex-extracted series name.
    """
    series: dict[str, list[Path]] = {}

    for entry in sorted(upload_dir.iterdir()):
        if entry.is_dir():
            files = sorted(
                (f for f in entry.iterdir()
                if f.is_file() and f.suffix.lower() in COMIC_EXTENSIONS),
                key=natural_sort_key,
            )
            if files:
                series[entry.name] = files
        elif entry.is_file() and entry.suffix.lower() in COMIC_EXTENSIONS:
            name = series_name_from_file(entry.stem)
            series.setdefault(name, []).append(entry)

    # Sort file-based series files
    for name in series:
        series[name] = sorted(series[name], key=natural_sort_key)

    return series


IMAGE_EXTENSIONS = {".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp", ".tiff"}


def count_pages(filepath: Path) -> int:
    """Count image pages inside a comic archive."""
    suffix = filepath.suffix.lower()
    if suffix == ".cbz":
        try:
            with zipfile.ZipFile(filepath) as zf:
                return sum(
                    1 for name in zf.namelist()
                    if Path(name).suffix.lower() in IMAGE_EXTENSIONS
                )
        except zipfile.BadZipFile:
            pass
    elif suffix == ".cbr":
        proc = subprocess.Popen(
            ["7z", "l", "-slt", str(filepath)],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
        )
        try:
            stdout, _ = proc.communicate(timeout=30)
            return sum(
                1 for line in stdout.splitlines()
                if line.startswith("Path = ")
                and Path(line.split(" = ", 1)[1]).suffix.lower() in IMAGE_EXTENSIONS
            )
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.communicate()
        except OSError:
            pass
    # Fallback for PDF or unreadable archives: count as 1 file = ~30 pages
    return 30


def files_to_move(files: list[Path], target_pages: int) -> list[Path]:
    """Select files to move: all if total pages <= target, else accumulate until >= target."""
    page_counts = [(f, count_pages(f)) for f in files]
    total_pages = sum(p for _, p in page_counts)
    if total_pages <= target_pages:
        return list(files)

    selected = []
    accumulated = 0
    for f, pages in page_counts:
        selected.append(f)
        accumulated += pages
        if accumulated >= target_pages:
            break
    return selected


def move_files(
    files: list[Path],
    series_name: str,
    comics_dir: Path,
    upload_dir: Path,
    dry_run: bool,
) -> None:
    dest_dir = comics_dir / series_name
    if dry_run:
        print(f"[dry-run] Would create directory: {dest_dir}")
    else:
        dest_dir.mkdir(parents=True, exist_ok=True)
        # Force group-writable + setgid so comics-rw members (e.g. felix over
        # Samba) can add volumes to the series later. A bare mkdir leaves it
        # 0755 (umask), which blocks group writes even though /srv/comics is
        # 2775. chmod also repairs the mode on pre-existing dirs.
        dest_dir.chmod(0o2775)

    for f in files:
        dest = dest_dir / f.name
        if dry_run:
            print(f"[dry-run] Would move: {f} -> {dest}")
        else:
            print(f"Moving: {f} -> {dest}")
            shutil.move(str(f), str(dest))

    # Clean up empty source directory
    if files:
        source_dir = files[0].parent
        if source_dir != upload_dir and source_dir.is_dir():
            remaining = list(source_dir.iterdir())
            if not remaining:
                if dry_run:
                    print(f"[dry-run] Would remove empty directory: {source_dir}")
                else:
                    print(f"Removing empty directory: {source_dir}")
                    source_dir.rmdir()


def notify(title: str, message: str, tags: str = "", priority: str = "default") -> None:
    """Send a notification via ntfy."""
    if not NTFY_TOKEN:
        return
    url = f"{NTFY_URL}/{NTFY_TOPIC}"
    headers = {
        "Authorization": f"Bearer {NTFY_TOKEN}",
        # Percent-encode the title — Python's HTTP layer encodes headers as
        # latin-1, which can't represent emoji codepoints. ntfy decodes the
        # percent-encoded form on its side. (See manga-chapter-checker.py.)
        "Title": urllib.parse.quote(title, safe=" "),
        "Priority": priority,
    }
    if tags:
        headers["Tags"] = tags
    req = urllib.request.Request(url, data=message.encode(), headers=headers)
    try:
        urllib.request.urlopen(req, timeout=10).close()
    except Exception as exc:
        print(f"Warning: ntfy notification failed: {exc}", file=sys.stderr)


def scan_komga(dry_run: bool) -> None:
    """Trigger a library scan on all Komga libraries."""
    if dry_run:
        print("[dry-run] Would trigger Komga library scan")
        return
    token = b64encode(f"{KOMGA_USER}:{KOMGA_PASSWORD}".encode()).decode()
    headers = {"Authorization": f"Basic {token}"}
    try:
        req = urllib.request.Request(f"{KOMGA_URL}/api/v1/libraries", headers=headers)
        with urllib.request.urlopen(req, timeout=10) as resp:
            libraries = json.load(resp)
        for lib in libraries:
            lib_id = lib["id"]
            scan_req = urllib.request.Request(
                f"{KOMGA_URL}/api/v1/libraries/{lib_id}/scan",
                data=b"",
                headers=headers,
                method="POST",
            )
            urllib.request.urlopen(scan_req, timeout=10).close()
            print(f"Triggered Komga scan for library: {lib['name']!r}")
    except Exception as exc:
        print(f"Warning: Komga scan failed: {exc}", file=sys.stderr)


def _refund_token(user: str) -> None:
    """Return one token to a member whose paid delivery could not be fulfilled.
    Mirrors the UI's refund() but stands alone so the worker never loses a spent
    token when a queued request turns out to be undeliverable."""
    user = (user or "").strip().lower()   # single lowercase token key (see UI _norm)
    TOKENS_FILE.parent.mkdir(parents=True, exist_ok=True)
    f = open(TOKENS_FILE, "a+")
    try:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.seek(0)
        raw = f.read()
        try:
            data = json.loads(raw) if raw.strip() else {}
        except json.JSONDecodeError:
            data = {}
        data.setdefault("users", {})
        rec = data["users"].setdefault(
            user, {"balance": 0, "last_grant": datetime.date.today().isoformat()}
        )
        rec["balance"] = rec.get("balance", 0) + 1
        f.seek(0)
        f.truncate()
        json.dump(data, f, indent=2)
        f.flush()
    finally:
        fcntl.flock(f, fcntl.LOCK_UN)
        f.close()


def deliver_one(item: dict, upload_dir: Path, comics_dir: Path, dry_run: bool) -> bool:
    """Deliver one queued request (one ~TARGET_PAGES batch of a series). Never
    raises: a charged request that cannot be fulfilled is refunded so a spent
    token is never lost. Returns True iff a batch was actually moved."""
    series = item.get("series", "")
    user = item.get("user") or "Scheduled"
    charged = bool(item.get("charged"))

    discovered = discover_series(upload_dir)
    files = discovered.get(series)
    if not files:
        print(f"Series {series!r} not available (empty or removed). Skipping.", file=sys.stderr)
        if charged and not dry_run:
            _refund_token(user)
            print(f"Refunded 1 token to {user} (undeliverable).")
        return False

    try:
        batch = files_to_move(files, TARGET_PAGES)
        total_pages = sum(count_pages(f) for f in batch)
        print(f"Series: {series!r} ({len(files)} files remaining)")
        print(f"Moving {len(batch)} file(s) (~{total_pages} pages)")
        move_files(batch, series, comics_dir, upload_dir, dry_run)
        if not dry_run:
            notify(
                f"📚 {series}",
                f"{len(batch)} file(s) delivered (~{total_pages} pages)\n"
                f"{len(files) - len(batch)} file(s) remaining\n"
                f"Triggered by: {user}",
                tags="books",
            )
        print("Done.")
        return True
    except Exception as exc:
        print(f"Error delivering {series!r}: {exc}", file=sys.stderr)
        if charged and not dry_run:
            _refund_token(user)
            print(f"Refunded 1 token to {user} (delivery failed).")
        return False


def drain_queue(upload_dir: Path, comics_dir: Path, dry_run: bool) -> None:
    """Drain the delivery queue, one series per pop, until it is empty.

    Only one worker drains at a time (WORKER_LOCK, taken non-blocking). The
    hand-off is race-free: when the queue is found empty the worker releases
    WORKER_LOCK *before* the queue lock. A producer must hold the queue lock to
    append, so anything enqueued after our empty check is guaranteed to see
    WORKER_LOCK already free and can start a fresh worker. No queued request is
    ever dropped — even when systemd coalesces the `systemctl start` that woke
    us into an already-running run."""
    wlock = open(WORKER_LOCK, "w")
    try:
        fcntl.flock(wlock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("Another delivery worker is active; it will drain the queue. Exiting.")
        wlock.close()
        return

    delivered_any = False
    while True:
        qf = open(QUEUE_FILE, "a+")
        fcntl.flock(qf, fcntl.LOCK_EX)
        qf.seek(0)
        raw = qf.read()
        try:
            queue = json.loads(raw) if raw.strip() else []
        except json.JSONDecodeError:
            queue = []

        if not queue:
            # Hand off — release order matters (see docstring): worker lock first.
            fcntl.flock(wlock, fcntl.LOCK_UN)
            wlock.close()
            fcntl.flock(qf, fcntl.LOCK_UN)
            qf.close()
            break

        item = queue.pop(0)
        qf.seek(0)
        qf.truncate()
        json.dump(queue, qf, indent=2)
        qf.flush()
        fcntl.flock(qf, fcntl.LOCK_UN)
        qf.close()

        if deliver_one(item, upload_dir, comics_dir, dry_run):
            delivered_any = True

    # One library scan covers every batch moved this drain.
    if delivered_any:
        scan_komga(dry_run)


def main() -> None:
    parser = argparse.ArgumentParser(description="Manga Scheduler")
    parser.add_argument("--dry-run", action="store_true", help="Print actions without executing")
    parser.add_argument("--upload-dir", type=Path, default=UPLOAD_DIR, help="Override upload directory")
    parser.add_argument("--comics-dir", type=Path, default=COMICS_DIR, help="Override comics destination directory")
    parser.add_argument("--series", metavar="NAME",
                        help="Deliver this one series now, bypassing the queue "
                             "(testing/admin CLI; no token accounting)")
    args = parser.parse_args()

    upload_dir: Path = args.upload_dir
    comics_dir: Path = args.comics_dir

    if not upload_dir.is_dir():
        print(f"Upload directory does not exist: {upload_dir}", file=sys.stderr)
        sys.exit(1)

    if args.series:
        # Direct one-shot delivery — manual/admin runs and tests, no queue.
        if deliver_one({"series": args.series, "user": "CLI", "charged": False},
                       upload_dir, comics_dir, args.dry_run):
            scan_komga(args.dry_run)
        return

    # Normal path: drain everything the UI has queued, one series per pop.
    drain_queue(upload_dir, comics_dir, args.dry_run)


if __name__ == "__main__":
    main()
